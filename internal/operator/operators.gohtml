<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Operators - Vault Server</title>
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <a class="button button-outline" href="/secrets.html">Secrets</a>
      <a class="button button-outline" href="/tokens.html">API tokens</a>
      <a class="button button-outline" href="/audits.html">Audit log</a>
      {{if .IsAdmin}}<a class="button" aria-current="page" href="/operators.html">Operators</a>
      {{if .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
      <a class="button button-outline" href="/security.html">Security</a>{{end}}
      <a class="button button-outline" href="/account.html">Account</a>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <div class="token-page-header">
      <h2 class="section-label">Operator accounts</h2>
      <button id="openCreateOperator" type="button">Add operator</button>
    </div>
    <p>Operators can manage secrets, API tokens, and audit events within their allowed secret path prefixes. Each prefix includes that path and its descendants. Locking an operator revokes their sessions. If MFA is enforced, operators must re-enroll after 2FA is removed.</p>
    <h3 class="section-label">Current operators</h3>
    <ul id="operators" class="operator-list" aria-live="polite"></ul>
  </section>
  <dialog id="createOperatorDialog" class="admin-dialog" aria-labelledby="createOperatorTitle">
    <form id="operatorForm">
      <div class="admin-dialog-heading">
        <h2 id="createOperatorTitle">Add operator</h2>
        <button id="closeCreateOperator" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
      </div>
      <div id="operatorDialogError" class="notice" role="alert"></div>
      <label for="operatorUsername">Username</label>
      <input id="operatorUsername" name="username" maxlength="128" required>
      <label for="operatorPrefixes">Allowed secret path prefixes (up to 100, one per line)</label>
      <textarea id="operatorPrefixes" name="prefixes" rows="4" required placeholder="team-a&#10;shared/build"></textarea>
      <div class="row-actions admin-dialog-actions">
        <button id="createOperator" type="submit">Create operator</button>
      </div>
      <section id="generatedPasswordPanel" class="credential-panel" hidden>
        <h3>Copy the temporary password</h3>
        <p>This password is shown only once. The operator must change it when they first sign in.</p>
        <label for="generatedOperatorPassword">Temporary password</label>
        <input id="generatedOperatorPassword" type="text" readonly autocomplete="off">
        <div class="row-actions admin-dialog-actions">SAP 
          <button id="copyOperatorPassword" type="button">Copy password</button>
        </div>
        <p id="operatorPasswordCopyStatus" role="status" class="muted">Copy the password or select it to copy manually.</p>
        <label><input id="acknowledgeOperatorPassword" type="checkbox"> I have copied or recorded this password.</label>
      </section>
    </form>
  </dialog>
  <dialog id="operatorPrefixesDialog" class="admin-dialog" aria-labelledby="operatorPrefixesTitle">
    <form id="operatorPrefixesForm">
      <div class="admin-dialog-heading">
        <h2 id="operatorPrefixesTitle">Edit operator access</h2>
        <button id="closeOperatorPrefixes" class="button button-outline" type="button">Close</button>
      </div>
      <div id="operatorPrefixesError" class="notice" role="alert"></div>
      <label for="editOperatorPrefixes">Allowed secret path prefixes (up to 100, one per line)</label>
      <textarea id="editOperatorPrefixes" rows="5" required></textarea>
      <div class="row-actions admin-dialog-actions">
        <button type="submit">Save access</button>
      </div>
    </form>
  </dialog>
  <dialog id="resetOperatorPasswordDialog" class="admin-dialog" aria-labelledby="resetOperatorPasswordTitle">
    <div class="admin-dialog-heading">
      <h2 id="resetOperatorPasswordTitle">Temporary operator password</h2>
      <button id="closeResetOperatorPassword" class="button button-outline" type="button" aria-label="Close dialog" disabled>Close</button>
    </div>
    <p>This password is shown only once. Copy or record it and deliver it securely. The operator must change it at their next login; their active sessions have been revoked.</p>
    <label for="resetOperatorPasswordValue">Temporary password</label>
    <input id="resetOperatorPasswordValue" type="text" readonly autocomplete="off">
    <div class="row-actions admin-dialog-actions">
      <button id="copyResetOperatorPassword" type="button">Copy password</button>
    </div>
    <p id="resetOperatorPasswordCopyStatus" role="status" class="muted">Copy the password or select it to copy manually.</p>
    <label><input id="acknowledgeResetOperatorPassword" type="checkbox"> I have copied or recorded this password.</label>
  </dialog>
</main>
<script>
const errorBox = document.getElementById('error');
const createDialog = document.getElementById('createOperatorDialog');
const resetPasswordDialog = document.getElementById('resetOperatorPasswordDialog');
const prefixesDialog = document.getElementById('operatorPrefixesDialog');
let passwordAcknowledgementRequired = false;
let resetPasswordAcknowledgementRequired = false;
let editingOperator = '';
async function api(url, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}
function renderOperators(operators) {
  const list = document.getElementById('operators');
  list.replaceChildren();
  if (operators.length === 0) {
    const empty = document.createElement('li');
    empty.className = 'operator-empty';
    empty.textContent = 'No operators have been added.';
    list.append(empty);
    return;
  }
  for (const operator of operators) {
    const item = document.createElement('li');
    item.className = 'operator-item';
    const identity = document.createElement('div');
    identity.className = 'operator-identity';
    const label = document.createElement('span');
    label.className = 'operator-name';
    label.textContent = operator.username;
    const status = document.createElement('span');
    status.className = `operator-badge ${operator.locked ? 'operator-badge-locked' : 'operator-badge-active'}`;
    status.textContent = operator.locked ? 'Locked' : 'Active';
    const mfaStatus = document.createElement('span');
    mfaStatus.className = 'operator-badge operator-badge-muted';
    mfaStatus.textContent = operator.mfa_enabled ? '2FA enabled' :
      operator.mfa_configured ? '2FA setup pending' : '2FA disabled';
    const prefixes = document.createElement('span');
    prefixes.className = 'operator-badge operator-badge-muted';
    prefixes.textContent = operator.prefixes.length ? 'Paths: ' + operator.prefixes.join(', ') : 'No secret path access';
    identity.append(label, status, mfaStatus, prefixes);
    const actions = document.createElement('div');
    actions.className = 'operator-actions';
    const lock = document.createElement('button');
    lock.type = 'button';
    lock.className = 'button button-outline';
    lock.textContent = operator.locked ? 'Unlock' : 'Lock';
    lock.addEventListener('click', () => setOperatorLock(operator));
    const removeMFA = document.createElement('button');
    removeMFA.type = 'button';
    removeMFA.className = 'button button-outline';
    removeMFA.textContent = 'Remove 2FA';
    removeMFA.disabled = !operator.mfa_configured;
    removeMFA.addEventListener('click', () => removeOperatorMFA(operator.username));
    const resetPassword = document.createElement('button');
    resetPassword.type = 'button';
    resetPassword.className = 'button button-outline';
    resetPassword.textContent = 'Reset password';
    resetPassword.addEventListener('click', () => resetOperatorPassword(operator, resetPassword));
    const editPrefixes = document.createElement('button');
    editPrefixes.type = 'button';
    editPrefixes.className = 'button button-outline';
    editPrefixes.textContent = 'Edit paths';
    editPrefixes.addEventListener('click', () => {
      editingOperator = operator.username;
      document.getElementById('operatorPrefixesTitle').textContent = `Edit paths for ${operator.username}`;
      document.getElementById('operatorPrefixesError').textContent = '';
      document.getElementById('editOperatorPrefixes').value = operator.prefixes.join('\n');
      prefixesDialog.showModal();
    });
    actions.append(lock, removeMFA, resetPassword, editPrefixes);
    item.append(identity, actions);
    list.append(item);
  }
}
async function loadOperators() {
  try {
    const result = await api('/v1/operators/details');
    renderOperators(result.operators);
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
async function setOperatorLock(operator) {
  const locked = !operator.locked;
  const action = locked ? 'lock' : 'unlock';
  if (!window.confirm(`${action[0].toUpperCase()}${action.slice(1)} operator "${operator.username}"?${locked ? ' Their active sessions will be revoked.' : ''}`)) return;
  errorBox.textContent = '';
  try {
    await api('/v1/operators/lock', {
      method:'PATCH',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({username:operator.username, locked})
    });
    await loadOperators();
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
async function removeOperatorMFA(username) {
  if (!window.confirm(`Remove 2FA for "${username}"? This revokes active sessions. If MFA enforcement is enabled, they must enroll again to use the account.`)) return;
  errorBox.textContent = '';
  try {
    await api('/v1/operators/totp', {
      method:'DELETE',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({username})
    });
    await loadOperators();
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
async function resetOperatorPassword(operator, button) {
  if (!window.confirm(`Reset the password for "${operator.username}"? This revokes their active sessions.`)) return;
  errorBox.textContent = '';
  button.disabled = true;
  try {
    const result = await api('/v1/operators/password', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({username:operator.username})
    });
    document.getElementById('resetOperatorPasswordTitle').textContent =
      `Temporary password for ${operator.username}`;
    document.getElementById('resetOperatorPasswordValue').value = result.temporary_password;
    document.getElementById('acknowledgeResetOperatorPassword').checked = false;
    document.getElementById('closeResetOperatorPassword').disabled = true;
    document.getElementById('resetOperatorPasswordCopyStatus').textContent =
      'Copy the password or select it to copy manually.';
    resetPasswordAcknowledgementRequired = true;
    resetPasswordDialog.showModal();
    await loadOperators();
  } catch (error) {
    errorBox.textContent = error.message;
  } finally {
    button.disabled = false;
  }
}
document.getElementById('operatorForm').addEventListener('submit', async event => {
  event.preventDefault();
  const dialogError = document.getElementById('operatorDialogError');
  dialogError.textContent = '';
  const button = document.getElementById('createOperator');
  button.disabled = true;
  document.getElementById('closeCreateOperator').disabled = true;
  passwordAcknowledgementRequired = true;
  try {
    const result = await api('/v1/operators', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        username:document.getElementById('operatorUsername').value,
        prefixes:document.getElementById('operatorPrefixes').value.split('\n').map(prefix => prefix.trim()).filter(Boolean)
      })
    });
    document.getElementById('operatorUsername').disabled = true;
    button.hidden = true;
    document.getElementById('generatedOperatorPassword').value = result.initial_password;
    document.getElementById('generatedPasswordPanel').hidden = false;
    await loadOperators();
  } catch (error) {
    dialogError.textContent = error.message;
    document.getElementById('closeCreateOperator').disabled = false;
    passwordAcknowledgementRequired = false;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('openCreateOperator').addEventListener('click', () => {
  document.getElementById('operatorDialogError').textContent = '';
  createDialog.showModal();
  document.getElementById('operatorUsername').focus();
});
document.getElementById('copyOperatorPassword').addEventListener('click', async () => {
  const passwordInput = document.getElementById('generatedOperatorPassword');
  const status = document.getElementById('operatorPasswordCopyStatus');
  passwordInput.focus();
  passwordInput.select();
  try {
    await navigator.clipboard.writeText(passwordInput.value);
    status.textContent = 'Password copied. Confirm below before closing.';
  } catch {
    status.textContent = 'Clipboard access failed. The password is selected; copy it manually, then confirm below.';
  }
});
document.getElementById('acknowledgeOperatorPassword').addEventListener('change', event => {
  document.getElementById('closeCreateOperator').disabled = !event.target.checked;
});
document.getElementById('closeCreateOperator').addEventListener('click', () => {
  if (!passwordAcknowledgementRequired || document.getElementById('acknowledgeOperatorPassword').checked) {
    createDialog.close();
  }
});
createDialog.addEventListener('cancel', event => {
  if (passwordAcknowledgementRequired && !document.getElementById('acknowledgeOperatorPassword').checked) {
    event.preventDefault();
  }
});
createDialog.addEventListener('close', () => {
  document.getElementById('operatorForm').reset();
  document.getElementById('operatorUsername').disabled = false;
  document.getElementById('createOperator').hidden = false;
  document.getElementById('generatedPasswordPanel').hidden = true;
  document.getElementById('generatedOperatorPassword').value = '';
  document.getElementById('closeCreateOperator').disabled = false;
  passwordAcknowledgementRequired = false;
  document.getElementById('operatorDialogError').textContent = '';
  document.getElementById('operatorPasswordCopyStatus').textContent = 'Copy the password or select it to copy manually.';
});
document.getElementById('copyResetOperatorPassword').addEventListener('click', async () => {
  const passwordInput = document.getElementById('resetOperatorPasswordValue');
  const status = document.getElementById('resetOperatorPasswordCopyStatus');
  passwordInput.focus();
  passwordInput.select();
  try {
    await navigator.clipboard.writeText(passwordInput.value);
    status.textContent = 'Password copied. Confirm below before closing.';
  } catch {
    status.textContent = 'Clipboard access failed. The password is selected; copy it manually, then confirm below.';
  }
});
document.getElementById('acknowledgeResetOperatorPassword').addEventListener('change', event => {
  document.getElementById('closeResetOperatorPassword').disabled = !event.target.checked;
});
document.getElementById('closeResetOperatorPassword').addEventListener('click', () => {
  if (document.getElementById('acknowledgeResetOperatorPassword').checked) {
    resetPasswordDialog.close();
  }
});
resetPasswordDialog.addEventListener('cancel', event => {
  if (resetPasswordAcknowledgementRequired &&
      !document.getElementById('acknowledgeResetOperatorPassword').checked) {
    event.preventDefault();
  }
});
resetPasswordDialog.addEventListener('close', () => {
  document.getElementById('resetOperatorPasswordValue').value = '';
  document.getElementById('acknowledgeResetOperatorPassword').checked = false;
  document.getElementById('closeResetOperatorPassword').disabled = true;
  document.getElementById('resetOperatorPasswordTitle').textContent = 'Temporary operator password';
  document.getElementById('resetOperatorPasswordCopyStatus').textContent =
    'Copy the password or select it to copy manually.';
  resetPasswordAcknowledgementRequired = false;
});
loadOperators();
document.getElementById('closeOperatorPrefixes').addEventListener('click', () => prefixesDialog.close());
document.getElementById('operatorPrefixesForm').addEventListener('submit', async event => {
  event.preventDefault();
  const error = document.getElementById('operatorPrefixesError');
  error.textContent = '';
  try {
    await api('/v1/operators/prefixes', {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        username:editingOperator,
        prefixes:document.getElementById('editOperatorPrefixes').value.split('\n').map(prefix => prefix.trim()).filter(Boolean)
      })
    });
    prefixesDialog.close();
    await loadOperators();
  } catch (failure) {
    error.textContent = failure.message;
  }
});
</script>
</body>
</html>
