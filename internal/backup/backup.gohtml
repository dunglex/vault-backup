<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Backup - Vault Server</title>
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
     <div id="app-nav-links" class="app-nav-links">
        {{if .IsAdmin}}<a class="button button-outline" href="/mounts.html">Engines</a>{{end}}
        <a class="button button-outline" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API</a>
        <a class="button button-outline" href="/audits.html">Audit</a>
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button" aria-current="page" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <div class="token-page-header">
      <h2 class="section-label">Server backups</h2>
      <div class="row-actions">
        <button id="openBackupSettings" class="button button-outline" type="button">Schedule backup</button>
        <button id="openS3Settings" class="button button-outline" type="button">S3 copy settings</button>
        <button id="createServerBackup" type="button">Create backup now</button>
      </div>
    </div>
    <p class="muted">Last successful backup: <span id="lastServerBackup">None</span></p>
    <p id="s3Status" class="muted" role="status"></p>
    <table>
      <thead><tr><th>Name</th><th>File size</th><th>Created</th><th>Operators</th><th>Secrets</th><th>API tokens</th><th>Actions</th></tr></thead>
      <tbody id="backups"></tbody>
    </table>
    <p id="backupsEmpty" class="muted" hidden>No server backups found.</p>
  </section>
</main>
<dialog id="backupSettingsDialog" class="admin-dialog" aria-labelledby="backupSettingsTitle">
  <form id="backupSettingsForm">
    <div class="admin-dialog-heading">
      <h2 id="backupSettingsTitle">Schedule backup</h2>
      <button id="closeBackupSettings" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <label class="setting-option">
      <input id="automaticServerBackup" type="checkbox">
      Enable scheduled server backups
    </label>
    <label for="serverBackupCron">Backup schedule (six-field cron, UTC)</label>
    <input id="serverBackupCron" type="text" maxlength="128" value="0 0 2 * * *" autocomplete="off" spellcheck="false">
    <p class="muted">Every day at 02:00:00 UTC by default. Archives older than 30 days are removed after a successful backup.</p>
    <p id="backupSettingsError" class="notice" role="alert"></p>
    <div class="row-actions admin-dialog-actions">
      <span id="saved" class="success" role="status"></span>
      <button id="saveBackupSettings" type="submit">Save backup settings</button>
    </div>
  </form>
</dialog>
<dialog id="s3SettingsDialog" class="admin-dialog" aria-labelledby="s3SettingsTitle">
  <form id="s3SettingsForm">
    <div class="admin-dialog-heading">
      <h2 id="s3SettingsTitle">S3 copy settings</h2>
      <button id="closeS3Settings" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <label class="setting-option">
      <input id="s3Enabled" type="checkbox">
      Copy each created backup to S3
    </label>
    <p class="muted">Disabled by default. Backups are first created locally, then uploaded after the server databases reopen.</p>
    <label for="s3Endpoint">S3 endpoint (optional)</label>
    <input id="s3Endpoint" type="url" maxlength="512" placeholder="https://s3.amazonaws.com">
    <label for="s3Region">Region</label>
    <input id="s3Region" maxlength="128" placeholder="us-east-1">
    <label for="s3Bucket">Bucket</label>
    <input id="s3Bucket" maxlength="255" required>
    <label for="s3Prefix">Object key prefix (optional)</label>
    <input id="s3Prefix" maxlength="512" placeholder="vault-server/backups">
    <label for="s3AccessKeyId">Access key ID</label>
    <input id="s3AccessKeyId" maxlength="512" autocomplete="off">
    <label for="s3SecretAccessKey">Secret access key</label>
    <input id="s3SecretAccessKey" type="password" maxlength="512" autocomplete="new-password" placeholder="Leave blank to keep the saved key">
    <label for="s3SessionToken">Session token (optional)</label>
    <input id="s3SessionToken" type="password" maxlength="4096" autocomplete="off">
    <label class="setting-option">
      <input id="s3PathStyle" type="checkbox">
      Use path-style bucket URLs
    </label>
    <p id="s3SettingsError" class="notice" role="alert"></p>
    <div class="row-actions admin-dialog-actions">
      <button id="saveS3Settings" type="submit">Save S3 settings</button>
      <button id="testS3Connection" class="button button-outline" type="button">Test S3 connection</button>
      <span id="s3Saved" class="success" role="status"></span>
    </div>
  </form>
</dialog>
<dialog id="restoreBackupDialog" class="admin-dialog" aria-labelledby="restoreBackupTitle">
  <div class="admin-dialog-heading">
    <h2 id="restoreBackupTitle">Restore server backup</h2>
    <button id="closeRestoreBackup" class="button button-outline" type="button">Close</button>
  </div>
  <div id="restoreError" class="notice" role="alert"></div>
  <p>Restoring replaces server data and pauses the service for the operation. Only restore a backup you created or trust.</p>
  <button id="confirmRestoreBackup" type="button">Restore this backup</button>
</dialog>
<script src="/api-loading.js"></script>
<script>
const errorBox = document.getElementById('error');
const backupSettingsDialog = document.getElementById('backupSettingsDialog');
const s3SettingsDialog = document.getElementById('s3SettingsDialog');
let restoreName = '';
async function api(path, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(path, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(body.error || 'Backup request failed');
  return body;
}
async function loadSettings() {
  const settings = await api('/v1/backup/settings');
  document.getElementById('automaticServerBackup').checked = settings.automatic_server_backup;
  document.getElementById('serverBackupCron').value = settings.server_backup_cron;
  document.getElementById('lastServerBackup').textContent = settings.server_backup_last_success || 'None';
  document.getElementById('s3Enabled').checked = settings.s3_enabled;
  document.getElementById('s3Status').textContent = settings.s3_enabled ? 'S3 copy is enabled.' : 'S3 copy is disabled.';
  document.getElementById('s3Endpoint').value = settings.s3_endpoint || '';
  document.getElementById('s3Region').value = settings.s3_region || '';
  document.getElementById('s3Bucket').value = settings.s3_bucket || '';
  document.getElementById('s3Prefix').value = settings.s3_prefix || '';
  document.getElementById('s3AccessKeyId').value = settings.s3_access_key_id || '';
  document.getElementById('s3SecretAccessKey').value = '';
  document.getElementById('s3SecretAccessKey').placeholder = settings.s3_secret_configured ? 'Leave blank to keep the saved key' : 'Secret access key';
  document.getElementById('s3SessionToken').value = '';
  document.getElementById('s3SessionToken').placeholder = settings.s3_session_token_configured ? 'Leave blank to keep the saved token' : 'Session token';
  document.getElementById('s3PathStyle').checked = settings.s3_path_style;
}
function formatFileSize(bytes) {
  const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
  let size = bytes;
  let unit = 0;
  while (size >= 1024 && unit < units.length - 1) {
    size /= 1024;
    unit += 1;
  }
  return `${unit === 0 ? size : size.toFixed(1)} ${units[unit]}`;
}
async function refreshBackups() {
  const body = document.getElementById('backups');
  body.replaceChildren();
  const result = await api('/v1/backup');
  for (const backup of result.backups) {
    const row = body.insertRow();
    [backup.name, formatFileSize(backup.size_bytes), new Date(backup.created_at).toLocaleString(), backup.operators ?? 'N/A', backup.secrets ?? 'N/A', backup.api_tokens ?? 'N/A'].forEach(value => {
      row.insertCell().textContent = String(value);
    });
    const action = row.insertCell();
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'button button-outline';
    button.textContent = 'Restore';
    button.addEventListener('click', () => {
      restoreName = backup.name;
      document.getElementById('restoreError').textContent = '';
      document.getElementById('restoreBackupDialog').showModal();
    });
    action.append(button);
  }
  document.getElementById('backupsEmpty').hidden = result.backups.length !== 0;
}
function s3Payload() {
  const payload = {
    s3_enabled:document.getElementById('s3Enabled').checked,
    s3_endpoint:document.getElementById('s3Endpoint').value.trim(),
    s3_region:document.getElementById('s3Region').value.trim(),
    s3_bucket:document.getElementById('s3Bucket').value.trim(),
    s3_prefix:document.getElementById('s3Prefix').value.trim(),
    s3_access_key_id:document.getElementById('s3AccessKeyId').value.trim(),
    s3_path_style:document.getElementById('s3PathStyle').checked
  };
  const secret = document.getElementById('s3SecretAccessKey').value;
  const sessionToken = document.getElementById('s3SessionToken').value;
  if (secret !== '') payload.s3_secret_access_key = secret;
  if (sessionToken !== '') payload.s3_session_token = sessionToken;
  return payload;
}
document.getElementById('openS3Settings').addEventListener('click', () => {
  document.getElementById('s3SettingsError').textContent = '';
  document.getElementById('s3Saved').textContent = '';
  s3SettingsDialog.showModal();
  document.getElementById('s3Enabled').focus();
});
document.getElementById('closeS3Settings').addEventListener('click', () => s3SettingsDialog.close());
document.getElementById('s3SettingsForm').addEventListener('submit', async event => {
  event.preventDefault();
  const saveButton = document.getElementById('saveS3Settings');
  document.getElementById('s3SettingsError').textContent = '';
  document.getElementById('s3Saved').textContent = '';
  saveButton.disabled = true;
  try {
    await api('/v1/backup/settings', {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(s3Payload())});
    document.getElementById('s3Saved').textContent = 'Saved';
    document.getElementById('s3Status').textContent = document.getElementById('s3Enabled').checked
      ? 'S3 copy is enabled.' : 'S3 copy is disabled.';
  } catch (error) {
    document.getElementById('s3SettingsError').textContent = error.message;
  } finally {
    saveButton.disabled = false;
  }
});
document.getElementById('testS3Connection').addEventListener('click', async () => {
  document.getElementById('s3Saved').textContent = '';
  document.getElementById('s3SettingsError').textContent = '';
  try {
    await api('/v1/backup/s3/test', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(s3Payload())});
    document.getElementById('s3Saved').textContent = 'Connection successful';
  } catch (error) {
    document.getElementById('s3SettingsError').textContent = error.message;
  }
});
document.getElementById('openBackupSettings').addEventListener('click', () => {
  document.getElementById('backupSettingsError').textContent = '';
  document.getElementById('saved').textContent = '';
  backupSettingsDialog.showModal();
  document.getElementById('automaticServerBackup').focus();
});
document.getElementById('closeBackupSettings').addEventListener('click', () => backupSettingsDialog.close());
document.getElementById('backupSettingsForm').addEventListener('submit', async event => {
  event.preventDefault();
  const saveButton = document.getElementById('saveBackupSettings');
  document.getElementById('backupSettingsError').textContent = '';
  document.getElementById('saved').textContent = '';
  saveButton.disabled = true;
  try {
    await api('/v1/backup/settings', {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({
      automatic_server_backup:document.getElementById('automaticServerBackup').checked,
      server_backup_cron:document.getElementById('serverBackupCron').value
    })});
    document.getElementById('saved').textContent = 'Saved';
  } catch (error) {
    document.getElementById('backupSettingsError').textContent = error.message;
  } finally {
    saveButton.disabled = false;
  }
});
document.getElementById('createServerBackup').addEventListener('click', async () => {
  try {
    await api('/v1/backup', {method:'POST'});
    await refreshBackups();
  } catch (error) { errorBox.textContent = error.message; }
});
document.getElementById('confirmRestoreBackup').addEventListener('click', async () => {
  if (!restoreName) return;
  if (!window.confirm(`Restore "${restoreName}"? This replaces current server data.`)) return;
  try {
    await api('/v1/backup/restore', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name:restoreName})});
    document.getElementById('restoreBackupDialog').close();
    await refreshBackups();
  } catch (error) { document.getElementById('restoreError').textContent = error.message; }
});
document.getElementById('closeRestoreBackup').addEventListener('click', () => document.getElementById('restoreBackupDialog').close());
Promise.all([loadSettings(), refreshBackups()]).catch(error => { errorBox.textContent = error.message; });
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
