<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Initial setup - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body class="auth-page setup-page">
<main class="panel auth-card">
  <div id="setupError" class="notice" role="alert" aria-live="assertive"></div>

  <section id="phase1">
    <form id="setupKeyForm">
      <label>Setup key<input id="setupKey" name="setup_key" autocomplete="off" required></label>
      <button type="submit">Validate key</button>
    </form>
  </section>

  <section id="phase2" hidden>
    <h2>Server domains and certificate</h2>
    <form id="domainsForm">
      <label>Main domain<input name="main_domain" placeholder="vault.example.com" required></label>
      <label>Alias domains<textarea name="alias_domains" rows="3" placeholder="vault-alias.example.com"></textarea></label>
      <label>Server certificate
        <select name="certificate_mode">
          <option value="self_signed">Self-signed certificate</option>
          {{if .ACMEAvailable}}<option value="acme">ACME / Let's Encrypt</option>{{end}}
        </select>
      </label>
      <button type="submit">Save and continue</button>
      <button id="skipDomains" type="button" class="button button-outline">Skip for now</button>
    </form>
  </section>

  <section id="phase3" hidden>
    <h2>Create administrator account</h2>
    <form id="adminForm">
      <label>Admin username<input name="username" autocomplete="username" required></label>
      <label>Password<input name="password" type="password" autocomplete="new-password" minlength="12" required></label>
      <label>Confirm password<input name="password_confirmation" type="password" autocomplete="new-password" minlength="12" required></label>
      <button type="submit">Continue to extensions</button>
    </form>
  </section>

  <section id="phase4" hidden>
    <h2>App extensions</h2>
    <p>Choose optional features for this Vault Server.</p>
    <form id="extensionsForm">
      <label class="setting-option">
        <input id="enableOperators" name="enable_operators" type="checkbox">
        Enable Operators
      </label>
      <p class="muted">Create and manage operator accounts with restricted secret path access.</p>
      <label class="setting-option">
        <input id="enableBackup" name="enable_backup" type="checkbox">
        Enable Backup
      </label>
      <p class="muted">Add server backup and restore tools for encrypted application data.</p>
      <button type="submit">Enable selected extensions</button>
      <button id="skipExtensions" type="button" class="button button-outline">Skip for now</button>
    </form>
  </section>

  <section id="phase5" role="status" hidden>
    <h2>Setup complete</h2>
    <p>Redirecting to login…</p>
    <p><a id="loginLink" href="/login.html">Continue to login</a></p>
  </section>
</main>
<script>
const setupKey = document.getElementById('setupKey');
const errorBox = document.getElementById('setupError');
const phases = [1, 2, 3, 4, 5].map(number => document.getElementById(`phase${number}`));
let pendingAdmin = null;

function showPhase(number) {
  phases.forEach((phase, index) => {
    phase.hidden = index + 1 !== number;
  });
  errorBox.textContent = '';
}

async function postJSON(path, values) {
  const response = await fetch(path, {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    credentials: 'same-origin',
    body: JSON.stringify(values)
  });
  const body = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(body.error || 'Setup failed');
  return body;
}

document.getElementById('setupKeyForm').addEventListener('submit', async event => {
  event.preventDefault();
  errorBox.textContent = '';
  try {
    await postJSON('/v1/setup/validate-key', {setup_key: setupKey.value});
    showPhase(2);
  } catch (error) {
    errorBox.textContent = error.message;
  }
});

document.getElementById('domainsForm').addEventListener('submit', async event => {
  event.preventDefault();
  errorBox.textContent = '';
  const values = Object.fromEntries(new FormData(event.currentTarget));
  values.setup_key = setupKey.value;
  values.alias_domains = values.alias_domains.split(/\r?\n/).map(domain => domain.trim()).filter(Boolean);
  try {
    await postJSON('/v1/setup/domains', values);
    showPhase(3);
  } catch (error) {
    errorBox.textContent = error.message;
  }
});

document.getElementById('skipDomains').addEventListener('click', () => showPhase(3));

document.getElementById('adminForm').addEventListener('submit', async event => {
  event.preventDefault();
  errorBox.textContent = '';
  const values = Object.fromEntries(new FormData(event.currentTarget));
  if (values.password !== values.password_confirmation) {
    errorBox.textContent = 'Passwords do not match';
    return;
  }
  pendingAdmin = values;
  showPhase(4);
});

async function completeSetup(enableOperators, enableBackup) {
  if (!pendingAdmin) return;
  pendingAdmin.setup_key = setupKey.value;
  pendingAdmin.enable_operators = enableOperators;
  pendingAdmin.enable_backup = enableBackup;
  try {
    const result = await postJSON('/v1/setup', pendingAdmin);
    document.getElementById('loginLink').href = result.redirect_url;
    showPhase(5);
    window.setTimeout(() => location.assign(result.redirect_url), 1500);
  } catch (error) {
    errorBox.textContent = error.message;
  }
}

document.getElementById('extensionsForm').addEventListener('submit', async event => {
  event.preventDefault();
  errorBox.textContent = '';
  await completeSetup(
    document.getElementById('enableOperators').checked,
    document.getElementById('enableBackup').checked
  );
});

document.getElementById('skipExtensions').addEventListener('click', () => completeSetup(false, false));
</script>
</body>
</html>
