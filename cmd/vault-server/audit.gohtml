<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Audit log - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
  <link rel="stylesheet" href="/notyf.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        {{if .IsAdmin}}<a class="button button-outline" href="/mounts.html">Engines</a>{{end}}
        <a class="button button-outline" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API</a>
        {{if or .IsAdmin .AllowOperatorAudit}}<a class="button" aria-current="page" href="/audits.html">Audit</a>{{end}}
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <details id="auditFilters" class="audit-filter-disclosure" open>
      <summary>Filters</summary>
      <div class="filters">
        <label>Year<select id="year"></select></label>
        <label>Search<input id="q" placeholder="Actor, resource, or detail"></label>
        <label>Actor<input id="actor" placeholder="Exact actor"></label>
        <label>Action<select id="action"><option value="">All</option><option>login</option><option>login_blocked</option><option>block_login_ip</option><option>unblock_login_ip</option><option>start_mfa_setup</option><option>enable_mfa</option><option>disable_mfa</option><option>regenerate_mfa_recovery_codes</option><option>list</option><option>read</option><option>create</option><option>update</option><option>delete</option><option>create_token</option><option>update_token_mounts</option><option>revoke_token</option><option>update_operator_mounts</option><option>issue_certificate</option><option>rotate_certificate</option><option>update_settings</option><option>server_backup</option></select></label>
        <label>Outcome<select id="outcome"><option value="">All</option><option>started</option><option>success</option><option>failure</option></select></label>
        <label>Source<select id="source"><option value="">All</option><option>web</option><option>api</option></select></label>
        <label>From<input id="from" type="date"></label>
        <label>To<input id="to" type="date"></label>
        <button id="filter">Filter</button>
      </div>
    </details>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Outcome</th><th>Source</th><th>Client IP</th><th>Resource / detail</th></tr></thead>
        <tbody id="events"></tbody>
      </table>
    </div>
    <div class="pager"><span id="summary"></span><div class="row-actions"><button id="previous" class="button-outline">Previous</button><button id="next" class="button-outline">Next</button></div></div>
  </section>
</main>
<script src="/notyf.js"></script>
<script src="/notifications.js"></script>
<script src="/api-loading.js"></script>
<script>
const errorBox = document.getElementById('error');
let offset = 0;
const limit = 100;
const yearSelect = document.getElementById('year');
const auditFilters = document.getElementById('auditFilters');
const auditFilterSummary = auditFilters.querySelector('summary');
const mobileAuditFilters = window.matchMedia('(max-width: 52rem)');

if (mobileAuditFilters.matches) auditFilters.open = false;

async function api(url, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}

function textCell(row, value, className = '') {
  const cell = row.insertCell();
  cell.textContent = value || '-';
  if (className) cell.className = className;
}

async function refresh() {
  try {
    const params = new URLSearchParams({year: yearSelect.value, limit, offset});
    for (const id of ['q','actor','action','outcome','source','from','to']) {
      const value = document.getElementById(id).value.trim();
      if (value) params.set(id, value);
    }
    const result = await api('/v1/audit?' + params);
    const body = document.getElementById('events');
    body.replaceChildren();
    for (const event of result.events) {
      const row = body.insertRow();
      textCell(row, event.created_at);
      textCell(row, event.actor);
      textCell(row, event.action);
      textCell(row, event.outcome, event.outcome);
      textCell(row, event.source);
      textCell(row, event.client_ip);
      textCell(row, [event.resource, event.detail].filter(Boolean).join(' - '));
    }
    document.getElementById('summary').textContent = `${result.total} event${result.total === 1 ? '' : 's'}; showing ${result.events.length}`;
    document.getElementById('previous').disabled = offset === 0;
    document.getElementById('next').disabled = offset + result.events.length >= result.total;
    errorBox.textContent = '';
  } catch (error) {
    errorBox.textContent = error.message;
  }
}

function updateDateBounds() {
  const year = yearSelect.value;
  document.getElementById('from').min = `${year}-01-01`;
  document.getElementById('from').max = `${year}-12-31`;
  document.getElementById('to').min = `${year}-01-01`;
  document.getElementById('to').max = `${year}-12-31`;
  for (const id of ['from', 'to']) {
    const input = document.getElementById(id);
    if (input.value && input.value.slice(0, 4) !== year) input.value = '';
  }
}

async function loadYears() {
  try {
    const result = await api('/v1/audit/years');
    const currentYear = String(new Date().getUTCFullYear());
    for (const year of result.years) {
      const option = document.createElement('option');
      option.value = String(year);
      option.textContent = String(year);
      yearSelect.append(option);
    }
    yearSelect.value = result.years.includes(Number(currentYear))
      ? currentYear
      : String(result.years[result.years.length - 1]);
    updateDateBounds();
    await refresh();
  } catch (error) {
    errorBox.textContent = error.message;
  }
}

document.getElementById('filter').onclick = () => {
  offset = 0;
  refresh();
  if (mobileAuditFilters.matches) auditFilters.open = false;
};
document.getElementById('previous').onclick = () => { offset = Math.max(0, offset - limit); refresh(); };
document.getElementById('next').onclick = () => { offset += limit; refresh(); };
yearSelect.onchange = () => { offset = 0; updateDateBounds(); refresh(); };
document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && mobileAuditFilters.matches && auditFilters.open) {
    auditFilters.open = false;
    auditFilterSummary.focus();
  } else if (event.key === 'Enter' && event.target !== auditFilterSummary) {
    offset = 0;
    refresh();
  }
});
document.addEventListener('click', event => {
  if (mobileAuditFilters.matches && auditFilters.open && !auditFilters.contains(event.target)) {
    auditFilters.open = false;
  }
});
loadYears();
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
