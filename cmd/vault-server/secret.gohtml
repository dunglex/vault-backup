<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Secrets - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        <a class="button" aria-current="page" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API tokens</a>
        <a class="button button-outline" href="/audits.html">Audit log</a>
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <div class="admin-grid">
    <aside class="panel">
      <p class="section-label">Related secrets</p>
      <ul id="paths"></ul>
    </aside>
    <section class="panel">
      <nav id="secretBreadcrumb" class="secret-breadcrumb" aria-label="Secret path" hidden>
        <ol id="secretBreadcrumbItems"></ol>
      </nav>
      <div class="secret-editor-heading">
        <div id="adminPathField" class="secret-editor-path">
          <input id="secretPath" aria-label="Secret path" placeholder="For example app/database">
        </div>
        <div id="operatorPathFields" class="secret-path-combine secret-editor-path" hidden>
          <select id="secretPrefix" aria-label="Allowed path prefix"></select>
          <input id="secretPathSuffix" aria-label="Path under selected prefix" placeholder="Path under prefix">
        </div>
        <div id="versionControls" class="secret-version-controls" hidden>
          <select id="versionSelect" aria-label="Secret version"></select>
        </div>
      </div>
      <textarea id="secretData" placeholder='{&#34;username&#34;:&#34;admin&#34;,&#34;password&#34;:&#34;secret&#34;}'></textarea>
      <div class="row-actions editor-actions">
        <button id="convert-format" class="button button-outline">JSON ↔ dotenv</button>
        <button id="convert-case" class="button button-outline">UPPERCASE ↔ lowercase</button>
        <span class="row-actions-spacer"></span>
        <button id="save">Save secret</button>
        <button id="delete" class="danger">Delete</button>
      </div>
    </section>
  </div>
</main>
<script src="/api-loading.js"></script>
<script>
const errorBox = document.getElementById('error');
let secrets = [];
let operatorPrefixes = [];
let isOperator = false;
const secretPathInput = document.getElementById('secretPath');
const secretPrefixSelect = document.getElementById('secretPrefix');
const secretPathSuffixInput = document.getElementById('secretPathSuffix');
const versionControls = document.getElementById('versionControls');
const versionSelect = document.getElementById('versionSelect');
let loadedSecretPath = '';
let currentVersion = 0;
let selectedVersion = 0;

function showError(message) {
  errorBox.classList.remove('notice-info');
  errorBox.setAttribute('role', 'alert');
  errorBox.textContent = message || '';
}
function showInfo(message) {
  errorBox.classList.add('notice-info');
  errorBox.setAttribute('role', 'status');
  errorBox.textContent = message || '';
}
function currentSecretPath() {
  if (!isOperator) return secretPathInput.value;
  const prefix = secretPrefixSelect.value;
  const suffix = secretPathSuffixInput.value.trim().replace(/^\/+|\/+$/g, '');
  return suffix ? `${prefix}/${suffix}` : prefix;
}
function setSecretPath(path) {
  if (!isOperator) {
    secretPathInput.value = path;
    return;
  }
  const prefix = operatorPrefixes
    .filter(candidate => path === candidate || path.startsWith(candidate + '/'))
    .sort((left, right) => right.length - left.length)[0];
  if (!prefix) throw new Error('Secret path is outside the allowed prefixes');
  secretPrefixSelect.value = prefix;
  secretPathSuffixInput.value = path === prefix ? '' : path.slice(prefix.length + 1);
}
function updatePathDisplay() {
  const path = currentSecretPath();
  if (loadedSecretPath && path !== loadedSecretPath) {
    clearVersionControls();
  }
  renderBreadcrumb(path);
  renderPaths(path);
}
function clearVersionControls() {
  loadedSecretPath = '';
  currentVersion = 0;
  selectedVersion = 0;
  versionControls.hidden = true;
  versionSelect.replaceChildren();
  document.getElementById('secretData').readOnly = false;
  document.getElementById('convert-format').disabled = false;
  document.getElementById('convert-case').disabled = false;
  document.getElementById('save').disabled = false;
  document.getElementById('delete').disabled = false;
}
async function api(url, options = {}) {
  options.headers = options.headers || {};
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}


async function refresh() {
  try {
    const result = await api('/v1/secrets');
    secrets = Array.isArray(result) ? result : [];
    renderPaths(currentSecretPath());
  } catch (error) { showError(error.message); }
}

function renderPaths(secretPath = '') {
  const list = document.getElementById('paths');
  list.replaceChildren();
  const normalized = secretPath.trim().replace(/^\/+|\/+$/g, '');
  const separator = normalized.lastIndexOf('/');
  const parent = separator >= 0 ? normalized.slice(0, separator + 1) : '';
  secrets.filter(path => !parent || (path.startsWith(parent) && path !== normalized)).slice(0, 5).forEach(path => {
    const li = document.createElement('li');
    const button = document.createElement('button');
    button.className = 'button button-outline secret-list-button';
    button.textContent = path;
    button.title = path;
    button.onclick = () => openSecret(path);
    li.appendChild(button);
    list.appendChild(li);
  });
}

function renderBreadcrumb(secretPath = '') {
  const nav = document.getElementById('secretBreadcrumb');
  const list = document.getElementById('secretBreadcrumbItems');
  list.replaceChildren();
  const normalized = secretPath.trim().replace(/^\/+|\/+$/g, '');
  if (!normalized) {
    nav.hidden = true;
    return;
  }

  nav.hidden = false;
  const rootItem = document.createElement('li');
  const rootLink = document.createElement('a');
  rootLink.href = '/secrets.html';
  rootLink.textContent = 'Secrets';
  rootItem.append(rootLink);
  list.append(rootItem);

  const segments = normalized.split('/');
  segments.forEach((segment, index) => {
    const item = document.createElement('li');
    const prefix = segments.slice(0, index + 1).join('/');
    const isCurrent = index === segments.length - 1;
    let validPrefix = true;
    try { validateSecretPath(prefix); } catch { validPrefix = false; }
    if (!isCurrent && validPrefix) {
      const link = document.createElement('a');
      link.href = '/secrets.html?group=' + encodeURIComponent(prefix);
      link.textContent = segment;
      item.append(link);
    } else {
      const label = document.createElement('span');
      label.textContent = segment;
      if (isCurrent) label.setAttribute('aria-current', 'page');
      item.append(label);
    }
    list.append(item);
  });
}

async function openSecret(path) {
  try {
    clearVersionControls();
    document.getElementById('secretData').value = '';
    showError();
    setSecretPath(path);
    const metadata = await api('/v1/secrets/' + encodeURIComponent(path) + '?metadata=true');
    if (!Array.isArray(metadata.versions)) throw new Error('Secret version metadata is invalid');
    loadedSecretPath = path;
    currentVersion = metadata.current_version;
    versionSelect.replaceChildren();
    metadata.versions.forEach(version => {
      const option = document.createElement('option');
      option.value = String(version.version);
      option.textContent = 'Version ' + version.version +
        (version.version === currentVersion ? ' (current)' : '') +
        (version.destroyed ? ' (destroyed)' : version.deleted ? ' (deleted)' : '');
      option.disabled = version.deleted || version.destroyed;
      versionSelect.append(option);
    });
    versionControls.hidden = false;
    renderBreadcrumb(path);
    renderPaths(path);
    const latestReadable = metadata.versions.find(version => !version.deleted && !version.destroyed);
    if (!latestReadable) {
      document.getElementById('secretData').value = '';
      document.getElementById('secretData').readOnly = true;
      document.getElementById('convert-format').disabled = true;
      document.getElementById('convert-case').disabled = true;
      document.getElementById('save').disabled = true;
      document.getElementById('delete').disabled = true;
      showError('No readable versions are available.');
      return;
    }
    await loadSecretVersion(path, latestReadable.version);
  } catch (error) { showError(error.message); }
}

async function loadSecretVersion(path, version) {
  const body = await api('/v1/secrets/' + encodeURIComponent(path) + '?version=' + encodeURIComponent(version));
  selectedVersion = body.version;
  document.getElementById('secretData').value = JSON.stringify(body.data, null, 2);
  versionSelect.value = String(selectedVersion);
  const viewingCurrent = selectedVersion === currentVersion;
  document.getElementById('secretData').readOnly = !viewingCurrent;
  document.getElementById('convert-format').disabled = !viewingCurrent;
  document.getElementById('convert-case').disabled = !viewingCurrent;
  document.getElementById('save').disabled = !viewingCurrent;
  document.getElementById('delete').disabled = !viewingCurrent;
  showInfo(viewingCurrent ? '' : 'Viewing an older version. Select the current version to edit or delete.');
}

versionSelect.addEventListener('change', async () => {
  if (!loadedSecretPath) return;
  try {
    await loadSecretVersion(loadedSecretPath, Number(versionSelect.value));
  } catch (error) { showError(error.message); }
});

secretPathInput.addEventListener('input', updatePathDisplay);
secretPathSuffixInput.addEventListener('input', updatePathDisplay);
secretPrefixSelect.addEventListener('change', updatePathDisplay);

function parseDotenv(content) {
  const data = {};
  for (const rawLine of content.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith('#')) continue;
    const match = line.match(/^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/);
    if (!match) throw new Error('Invalid dotenv line: ' + rawLine);
    let value = match[2].trim();
    if (value.length >= 2 && ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'")))) {
      value = value.slice(1, -1);
    } else {
      value = value.replace(/\s+#.*$/, '');
    }
    if (Object.prototype.hasOwnProperty.call(data, match[1])) {
      throw new Error('Duplicate dotenv key: ' + match[1]);
    }
    data[match[1]] = value;
  }
  return data;
}

function toDotenv(data) {
  return Object.keys(data).sort().map(key => {
    const rawValue = typeof data[key] === 'string' ? data[key] : JSON.stringify(data[key]);
    const escaped = rawValue.replace(/\\/g, '\\\\').replace(/\n/g, '\\n').replace(/"/g, '\\"');
    return key + '="' + escaped + '"';
  }).join('\n');
}

function parseEditorData() {
  const content = document.getElementById('secretData').value.trim();
  if (!content) throw new Error('Secret content is required');
  try {
    const data = JSON.parse(content);
    if (data === null || Array.isArray(data) || typeof data !== 'object') {
      throw new Error('JSON secret must be an object');
    }
    return {data, format: 'json'};
  } catch (error) {
    if (error instanceof SyntaxError) {
      const dotenv = parseDotenv(content);
      if (Object.keys(dotenv).length === 0) throw new Error('Content is neither valid JSON nor dotenv');
      return {data: dotenv, format: 'dotenv'};
    }
    throw error;
  }
}

function validateEditorData(parsed) {
  const keys = Object.keys(parsed.data);
  if (keys.length === 0) {
    throw new Error('Secret must contain at least one key');
  }
  for (const key of keys) {
    if (!key.trim()) throw new Error('Secret keys cannot be empty');
    if (parsed.format === 'dotenv' && !/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
      throw new Error('Invalid dotenv key: ' + key);
    }
    if (parsed.data[key] === undefined) {
      throw new Error('Secret value is invalid for key: ' + key);
    }
  }
  return parsed.data;
}

function validateSecretPath(path) {
  if (!path) throw new Error('Secret name is required');
  const segments = path.split('/');
  if (segments.some(segment => segment.length < 1 || segment.length > 127)) {
    throw new Error('Each secret name segment must be 1–127 characters');
  }
  if (segments.some(segment => !/^[A-Za-z0-9-]+$/.test(segment))) {
    throw new Error('Secret names may contain only letters, numbers, and hyphens');
  }
  return path;
}

document.getElementById('convert-format').addEventListener('click', () => {
  try {
    const editor = document.getElementById('secretData');
    const parsed = parseEditorData();
    if (parsed.format === 'json') {
      const data = parsed.data;
      editor.value = toDotenv(data);
      showError('Converted to dotenv');
    } else {
      editor.value = JSON.stringify(parsed.data, null, 2);
      showError('Converted to JSON');
    }
  } catch (error) {
    showError(error.message);
  }
});

document.getElementById('convert-case').addEventListener('click', () => {
  try {
    const parsed = parseEditorData();
    const data = parsed.data;
    const keys = Object.keys(data);
    if (keys.length === 0) throw new Error('Secret has no keys to convert');
    const convertToLower = keys.every(key => key === key.toUpperCase());
    const converted = {};
    for (const [key, value] of Object.entries(data)) {
      const nextKey = convertToLower ? key.toLowerCase() : key.toUpperCase();
      if (Object.prototype.hasOwnProperty.call(converted, nextKey)) {
        throw new Error('Key case conversion would create duplicate key: ' + nextKey);
      }
      converted[nextKey] = value;
    }
    document.getElementById('secretData').value = parsed.format === 'json'
      ? JSON.stringify(converted, null, 2)
      : toDotenv(converted);
    showError(convertToLower ? 'Converted keys to lowercase' : 'Converted keys to uppercase');
  } catch (error) {
    showError(error.message);
  }
});

document.getElementById('save').addEventListener('click', async () => {
  const path = currentSecretPath().trim().replace(/^\/+/, '').replace(/\/+$/, '');
  try {
    if (loadedSecretPath === path && selectedVersion !== currentVersion) {
      throw new Error('Select the current version before saving');
    }
    validateSecretPath(path);
    const data = validateEditorData(parseEditorData());
    if (!path) throw new Error('Secret path is required');
    const result = await api('/v1/secrets/' + encodeURIComponent(path), {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data})});
    await refresh();
    await openSecret(path);
    showError('Saved as version ' + result.version);
  } catch (error) { showError(error.message); }
});

document.getElementById('delete').addEventListener('click', async () => {
  const path = currentSecretPath().trim();
  if (loadedSecretPath === path && selectedVersion !== currentVersion) return;
  if (!path || !confirm('Delete ' + path + '?')) return;
  try {
    await api('/v1/secrets/' + encodeURIComponent(path), {method:'DELETE'});
    const separator = path.lastIndexOf('/');
    const parent = separator >= 0 ? path.slice(0, separator) : '';
    location.assign('/secrets.html?group=' + encodeURIComponent(parent));
  } catch (error) { showError(error.message); }
});

async function openInitialSecret() {
  try {
    const session = await api('/v1/session');
    isOperator = session.role === 'operator';
    if (isOperator) {
      operatorPrefixes = Array.isArray(session.secret_prefixes) ? session.secret_prefixes : [];
      document.getElementById('adminPathField').hidden = true;
      document.getElementById('operatorPathFields').hidden = false;
      secretPrefixSelect.replaceChildren();
      operatorPrefixes.forEach(prefix => {
        const option = document.createElement('option');
        option.value = prefix;
        option.textContent = prefix;
        secretPrefixSelect.append(option);
      });
      if (operatorPrefixes.length === 0) {
        const option = document.createElement('option');
        option.value = '';
        option.textContent = 'No allowed prefixes';
        secretPrefixSelect.append(option);
        secretPrefixSelect.disabled = true;
        secretPathSuffixInput.disabled = true;
        document.getElementById('save').disabled = true;
        document.getElementById('delete').disabled = true;
        showError('No secret path prefixes are assigned to this operator.');
      }
    }
    await refresh();
    const path = new URLSearchParams(location.search).get('path');
    if (path) await openSecret(path);
    else {
      renderPaths('');
      renderBreadcrumb('');
    }
  } catch (error) {
    showError(error.message);
  }
}

openInitialSecret();
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
