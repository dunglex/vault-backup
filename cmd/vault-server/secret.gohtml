<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Secrets - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/notyf.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        {{if .IsAdmin}}<a class="button button-outline" href="/mounts.html">Engines</a>{{end}}
        <a class="button" aria-current="page" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API</a>
        {{if or .IsAdmin .AllowOperatorAudit}}<a class="button button-outline" href="/audits.html">Audit</a>{{end}}
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div class="admin-grid secret-editor-layout">
    <aside class="panel">
      <p class="section-label">Related secrets</p>
      <ul id="paths"></ul>
    </aside>
    <section class="panel">
      <nav id="secretBreadcrumb" class="secret-breadcrumb" aria-label="Secret path" hidden>
        <ol id="secretBreadcrumbItems"></ol>
      </nav>
      <div id="secretTabs" class="secret-tabs" role="tablist" aria-label="Secret details" hidden>
        <button id="secretTab" class="secret-tab" type="button" role="tab" aria-selected="true" aria-controls="secretPanel">Secret</button>
        <button id="metadataTab" class="secret-tab" type="button" role="tab" aria-selected="false" aria-controls="secretMetadataPanel">Metadata</button>
        <button id="pathsTab" class="secret-tab" type="button" role="tab" aria-selected="false" aria-controls="secretAccessDetails">Paths</button>
        <button id="historyTab" class="secret-tab" type="button" role="tab" aria-selected="false" aria-controls="secretVersionHistory">History</button>
      </div>
      <section id="secretPanel" class="secret-tab-panel" role="tabpanel" aria-labelledby="secretTab">
        <div class="secret-editor-heading">
          <label>Engine
            <select id="secretMount"></select>
          </label>
          <div class="secret-editor-path">
            <input id="secretPath" aria-label="Secret path" placeholder="For example app/database">
          </div>
          <div id="versionControls" class="secret-version-controls" hidden>
            <select id="versionSelect" aria-label="Secret version"></select>
          </div>
        </div>
        <textarea id="secretData" placeholder='{&#34;username&#34;:&#34;admin&#34;,&#34;password&#34;:&#34;secret&#34;}'></textarea>
        <div class="row-actions editor-actions">
          <button id="convert-format" class="button button-outline">JSON ↔ dotenv</button>
          <button id="convert-case" class="button button-outline">UPPERCASE ↔ lowercase</button>
          <span class="row-actions-spacer"></span>
          <button id="save">Save secret</button>
          <button id="delete" class="danger">Delete</button>
        </div>
      </section>
      <section id="secretMetadataPanel" class="secret-tab-panel secret-metadata" role="tabpanel" aria-labelledby="metadataTab" hidden>
        <p class="muted">Stored metadata for this secret and the selected version.</p>
        <dl class="secret-metadata-grid">
          <div><dt>Engine</dt><dd id="metadataMount"></dd></div>
          <div><dt>Path</dt><dd id="metadataPath"></dd></div>
          <div><dt>Current version</dt><dd id="metadataCurrentVersion"></dd></div>
          <div><dt>Total versions</dt><dd id="metadataVersionCount"></dd></div>
          <div><dt>Created</dt><dd id="metadataCreatedAt"></dd></div>
          <div><dt>Last updated</dt><dd id="metadataUpdatedAt"></dd></div>
          <div><dt>Selected version</dt><dd id="metadataSelectedVersion"></dd></div>
          <div><dt>Version status</dt><dd id="metadataVersionStatus"></dd></div>
          <div><dt>Version created</dt><dd id="metadataVersionCreatedAt"></dd></div>
          <div><dt>Created by</dt><dd id="metadataCreatedBy"></dd></div>
          <div><dt>Deleted</dt><dd id="metadataDeletedAt"></dd></div>
          <div><dt>Destroyed</dt><dd id="metadataDestroyedAt"></dd></div>
        </dl>
      </section>
      <section id="secretVersionHistory" class="secret-tab-panel secret-version-history" role="tabpanel" aria-labelledby="historyTab" hidden>
        <div class="secret-version-history-heading">
          <div>
            <h2 id="secretVersionHistoryTitle">Version history</h2>
            <p>Review and open readable versions of this secret.</p>
          </div>
          <span id="secretVersionCount" class="secret-version-count"></span>
        </div>
        <div class="secret-version-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Version</th>
                <th scope="col">Created At</th>
                <th scope="col">Created by</th>
              </tr>
            </thead>
            <tbody id="secretVersionHistoryRows"></tbody>
          </table>
        </div>
      </section>
      <section id="secretAccessDetails" class="secret-tab-panel secret-access-details" role="tabpanel" aria-labelledby="pathsTab" hidden>
        <div class="secret-access-section">
          <h2 id="secretAccessPathsTitle">Paths</h2>
          <div class="secret-access-item">
            <div>
              <h3>CLI path</h3>
              <p>Engine and secret path for <code>vault-backup</code>.</p>
            </div>
            <div class="secret-access-value">
              <code id="secretCLIPath"></code>
              <button class="button button-outline" type="button" data-copy-target="secretCLIPath" aria-label="Copy CLI path">Copy</button>
            </div>
          </div>
          <div class="secret-access-item">
            <div>
              <h3>Data API path</h3>
              <p>Read endpoint for the secret data.</p>
            </div>
            <div class="secret-access-value">
              <code id="secretAPIPath"></code>
              <button class="button button-outline" type="button" data-copy-target="secretAPIPath" aria-label="Copy API path">Copy</button>
            </div>
          </div>
          <div class="secret-access-item">
            <div>
              <h3>Metadata API path</h3>
              <p>Read endpoint for secret version metadata.</p>
            </div>
            <div class="secret-access-value">
              <code id="secretMetadataAPIPath"></code>
              <button class="button button-outline" type="button" data-copy-target="secretMetadataAPIPath" aria-label="Copy metadata API path">Copy</button>
            </div>
          </div>
        </div>
        <div class="secret-access-section">
          <h2>Commands</h2>
          <div class="secret-access-item">
            <div>
              <h3>CLI read</h3>
              <p>Read the secret data with <code>vault-backup</code>.</p>
            </div>
            <div class="secret-access-value secret-access-command">
              <pre><code id="secretCLICommand"></code></pre>
              <button class="button button-outline" type="button" data-copy-target="secretCLICommand" aria-label="Copy CLI command">Copy</button>
            </div>
          </div>
          <div class="secret-access-item">
            <div>
              <h3>API read</h3>
              <p>Read the secret data with a managed API token.</p>
            </div>
            <div class="secret-access-value secret-access-command">
              <pre><code id="secretAPICurlCommand"></code></pre>
              <button class="button button-outline" type="button" data-copy-target="secretAPICurlCommand" aria-label="Copy API curl command">Copy</button>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
</main>
<script src="/notyf.js"></script>
<script src="/notifications.js"></script>
<script src="/date-time.js"></script>
<script src="/api-loading.js"></script>
<script>
window.vaultTimezone = {{if .Timezone}}{{.Timezone}}{{else}}"UTC"{{end}};
let secrets = [];
let allowedMounts = [];
let currentMount = new URLSearchParams(location.search).get('mount') || '';
const secretPathInput = document.getElementById('secretPath');
const secretMountSelect = document.getElementById('secretMount');
const versionControls = document.getElementById('versionControls');
const versionSelect = document.getElementById('versionSelect');
const secretTabs = document.getElementById('secretTabs');
const secretVersionHistory = document.getElementById('secretVersionHistory');
const secretVersionHistoryRows = document.getElementById('secretVersionHistoryRows');
const secretAccessDetails = document.getElementById('secretAccessDetails');
const secretMetadataPanel = document.getElementById('secretMetadataPanel');
let loadedSecretPath = '';
let currentVersion = 0;
let selectedVersion = 0;
let loadedSecretMetadata = null;

function showError(message) {
  window.vaultNotify.error(message);
}
function showInfo(message) {
  window.vaultNotify.info(message);
}
function showSuccess(message) {
  window.vaultNotify.success(message);
}
function currentSecretPath() {
  return secretPathInput.value;
}
function setSecretPath(path) {
  secretPathInput.value = path;
}
function secretAPI(path, query = '') {
  const params = new URLSearchParams({mount:currentMount});
  if (query) {
    const additional = new URLSearchParams(query);
    for (const [key, value] of additional) params.set(key, value);
  }
  return '/v1/secrets/' + encodeURIComponent(path) + '?' + params;
}
function updatePathDisplay() {
  const path = currentSecretPath();
  if (loadedSecretPath && path !== loadedSecretPath) {
    clearVersionControls();
  }
  renderBreadcrumb(path);
  renderPaths(path);
}
function clearVersionControls() {
  loadedSecretPath = '';
  currentVersion = 0;
  selectedVersion = 0;
  loadedSecretMetadata = null;
  versionControls.hidden = true;
  versionSelect.replaceChildren();
  secretMountSelect.disabled = false;
  secretPathInput.readOnly = false;
  secretTabs.hidden = true;
  selectSecretTab('secret');
  secretVersionHistory.hidden = true;
  secretVersionHistoryRows.replaceChildren();
  secretAccessDetails.hidden = true;
  secretMetadataPanel.hidden = true;
  document.getElementById('secretData').readOnly = false;
  document.getElementById('convert-format').disabled = false;
  document.getElementById('convert-case').disabled = false;
  document.getElementById('save').disabled = false;
  document.getElementById('delete').disabled = false;
}
function selectSecretTab(name) {
  if (!loadedSecretPath && name !== 'secret') name = 'secret';
  const tabs = {
    secret: {button: document.getElementById('secretTab'), panel: document.getElementById('secretPanel')},
    metadata: {button: document.getElementById('metadataTab'), panel: secretMetadataPanel},
    paths: {button: document.getElementById('pathsTab'), panel: secretAccessDetails},
    history: {button: document.getElementById('historyTab'), panel: secretVersionHistory}
  };
  Object.entries(tabs).forEach(([tabName, tab]) => {
    const selected = tabName === name;
    tab.button.setAttribute('aria-selected', String(selected));
    tab.button.tabIndex = selected ? 0 : -1;
    tab.panel.hidden = !selected;
  });
}
function formatMetadataTime(value) {
  return value ? window.vaultFormatDateTime(value) : '—';
}
function renderSecretMetadata(path) {
  if (!loadedSecretMetadata) return;
  document.getElementById('metadataMount').textContent = currentMount;
  document.getElementById('metadataPath').textContent = path;
  document.getElementById('metadataCurrentVersion').textContent = String(currentVersion);
  document.getElementById('metadataVersionCount').textContent = String(loadedSecretMetadata.versions.length);
  document.getElementById('metadataCreatedAt').textContent = formatMetadataTime(loadedSecretMetadata.created_at);
  document.getElementById('metadataUpdatedAt').textContent = formatMetadataTime(loadedSecretMetadata.updated_at);
  updateSelectedVersionMetadata();
}
function updateSelectedVersionMetadata() {
  const version = loadedSecretMetadata && loadedSecretMetadata.versions.find(item => item.version === selectedVersion);
  document.getElementById('metadataSelectedVersion').textContent = selectedVersion ? String(selectedVersion) : '—';
  document.getElementById('metadataVersionStatus').textContent = version ? secretVersionState(version) : '—';
  document.getElementById('metadataVersionCreatedAt').textContent = formatMetadataTime(version && version.created_at);
  document.getElementById('metadataCreatedBy').textContent = version && version.created_by || 'Unknown';
  document.getElementById('metadataDeletedAt').textContent = formatMetadataTime(version && version.deleted_at);
  document.getElementById('metadataDestroyedAt').textContent = formatMetadataTime(version && version.destroyed_at);
}
function secretVersionState(version) {
  if (version.destroyed) return 'Destroyed';
  if (version.deleted) return 'Deleted';
  if (version.version === currentVersion) return 'Current';
  return 'Available';
}
function renderVersionHistory(versions) {
  secretVersionHistoryRows.replaceChildren();
  document.getElementById('secretVersionCount').textContent =
    versions.length + (versions.length === 1 ? ' version' : ' versions');
  versions.forEach(version => {
    const row = document.createElement('tr');
    row.dataset.version = String(version.version);
    const versionCell = document.createElement('th');
    versionCell.scope = 'row';
    const versionButton = document.createElement('button');
    versionButton.type = 'button';
    versionButton.className = 'secret-version-link';
    versionButton.textContent = version.version;
    versionButton.dataset.version = String(version.version);
    versionButton.disabled = version.deleted || version.destroyed;
    versionButton.setAttribute('aria-label', 'View version ' + version.version);
    versionCell.append(versionButton);
    if (version.version === currentVersion) {
      const current = document.createElement('span');
      current.className = 'secret-version-badge current';
      current.textContent = 'Current';
      versionCell.append(' ', current);
    }
    const createdCell = document.createElement('td');
    createdCell.textContent = version.created_at
      ? window.vaultFormatDateTime(version.created_at)
      : 'Unknown';
    const creatorCell = document.createElement('td');
    creatorCell.textContent = version.created_by || 'Unknown';
    row.append(versionCell, createdCell, creatorCell);
    secretVersionHistoryRows.append(row);
  });
  secretVersionHistory.hidden = false;
}
function updateVersionHistorySelection() {
  secretVersionHistoryRows.querySelectorAll('tr').forEach(row => {
    const selected = Number(row.dataset.version) === selectedVersion;
    row.classList.toggle('is-selected', selected);
    const button = row.querySelector('button[data-version]');
    if (button) {
      button.setAttribute('aria-pressed', String(selected));
      button.disabled = selected || versionIsUnreadable(Number(row.dataset.version));
    }
  });
}
function versionIsUnreadable(versionNumber) {
  const version = loadedSecretMetadata &&
    loadedSecretMetadata.versions.find(item => item.version === versionNumber);
  return !version || version.deleted || version.destroyed;
}
function renderSecretAccessDetails(path) {
  const cliPath = '--secret_name ' + currentMount + ' --secret_path ' + path;
  const apiPath = '/api/v1/' + encodeURIComponent(currentMount) + '/data/' +
    path.split('/').map(encodeURIComponent).join('/');
  const apiURL = new URL(apiPath, location.origin).href;
  const metadataAPIPath = '/api/v1/' + encodeURIComponent(currentMount) + '/metadata/' +
    path.split('/').map(encodeURIComponent).join('/');
  const metadataAPIURL = new URL(metadataAPIPath, location.origin).href;
  document.getElementById('secretCLIPath').textContent = cliPath;
  document.getElementById('secretAPIPath').textContent = apiURL;
  document.getElementById('secretMetadataAPIPath').textContent = metadataAPIURL;
  document.getElementById('secretCLICommand').textContent = [
    'vault-backup \\',
    '  --url "' + location.origin + '/api" \\',
    '  --token "$VAULT_TOKEN" \\',
    '  --secret_name ' + currentMount + ' \\',
    '  --secret_path ' + path + ' \\',
    '  --output_mode data \\',
    '  --output_format json'
  ].join('\n');
  document.getElementById('secretAPICurlCommand').textContent =
    'curl -H \'X-Vault-Token: MANAGED_API_TOKEN\' \\\n' +
    '  "' + apiURL + '"';
  secretAccessDetails.hidden = false;
}
async function api(url, options = {}) {
  options.headers = options.headers || {};
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}


async function refresh() {
  try {
    const result = await api('/v1/secrets?mount=' + encodeURIComponent(currentMount));
    secrets = Array.isArray(result) ? result : [];
    renderPaths(currentSecretPath());
  } catch (error) { showError(error.message); }
}

function renderPaths(secretPath = '') {
  const list = document.getElementById('paths');
  list.replaceChildren();
  const normalized = secretPath.trim().replace(/^\/+|\/+$/g, '');
  const separator = normalized.lastIndexOf('/');
  const parent = separator >= 0 ? normalized.slice(0, separator + 1) : '';
  secrets.filter(path => !parent || (path.startsWith(parent) && path !== normalized)).slice(0, 10).forEach(path => {
    const li = document.createElement('li');
    const button = document.createElement('button');
    button.className = 'button button-outline secret-list-button';
    button.textContent = path;
    button.title = path;
    button.onclick = () => openSecret(path);
    li.appendChild(button);
    list.appendChild(li);
  });
}

function renderBreadcrumb(secretPath = '') {
  const nav = document.getElementById('secretBreadcrumb');
  const list = document.getElementById('secretBreadcrumbItems');
  list.replaceChildren();
  const normalized = secretPath.trim().replace(/^\/+|\/+$/g, '');
  if (!normalized) {
    nav.hidden = true;
    return;
  }

  nav.hidden = false;
  const rootItem = document.createElement('li');
  const rootLink = document.createElement('a');
  rootLink.href = '/secrets.html?mount=' + encodeURIComponent(currentMount);
  rootLink.textContent = 'Secrets';
  rootItem.append(rootLink);
  list.append(rootItem);

  const segments = normalized.split('/');
  segments.forEach((segment, index) => {
    const item = document.createElement('li');
    const prefix = segments.slice(0, index + 1).join('/');
    const isCurrent = index === segments.length - 1;
    let validPrefix = true;
    try { validateSecretPath(prefix); } catch { validPrefix = false; }
    if (!isCurrent && validPrefix) {
      const link = document.createElement('a');
      link.href = '/secrets.html?mount=' + encodeURIComponent(currentMount) + '&group=' + encodeURIComponent(prefix);
      link.textContent = segment;
      item.append(link);
    } else {
      const label = document.createElement('span');
      label.textContent = segment;
      if (isCurrent) label.setAttribute('aria-current', 'page');
      item.append(label);
    }
    list.append(item);
  });
}

async function openSecret(path) {
  try {
    clearVersionControls();
    document.getElementById('secretData').value = '';
    showError();
    setSecretPath(path);
    const metadata = await api(secretAPI(path, 'metadata=true'));
    if (!Array.isArray(metadata.versions)) throw new Error('Secret version metadata is invalid');
    loadedSecretPath = path;
    currentVersion = metadata.current_version;
    loadedSecretMetadata = metadata;
    secretMountSelect.disabled = true;
    secretPathInput.readOnly = true;
    renderSecretMetadata(path);
    renderVersionHistory(metadata.versions);
    renderSecretAccessDetails(path);
    secretTabs.hidden = false;
    selectSecretTab('secret');
    versionSelect.replaceChildren();
    metadata.versions.forEach(version => {
      const option = document.createElement('option');
      option.value = String(version.version);
      option.textContent = 'Version ' + version.version +
        (version.version === currentVersion ? ' (current)' : '') +
        (version.destroyed ? ' (destroyed)' : version.deleted ? ' (deleted)' : '');
      option.disabled = version.deleted || version.destroyed;
      versionSelect.append(option);
    });
    versionControls.hidden = false;
    renderBreadcrumb(path);
    renderPaths(path);
    const latestReadable = metadata.versions.find(version => !version.deleted && !version.destroyed);
    if (!latestReadable) {
      document.getElementById('secretData').value = '';
      document.getElementById('secretData').readOnly = true;
      document.getElementById('convert-format').disabled = true;
      document.getElementById('convert-case').disabled = true;
      document.getElementById('save').disabled = true;
      document.getElementById('delete').disabled = true;
      showError('No readable versions are available.');
      return;
    }
    await loadSecretVersion(path, latestReadable.version);
  } catch (error) { showError(error.message); }
}

async function loadSecretVersion(path, version) {
  const body = await api(secretAPI(path, 'version=' + encodeURIComponent(version)));
  selectedVersion = body.version;
  document.getElementById('secretData').value = JSON.stringify(body.data, null, 2);
  versionSelect.value = String(selectedVersion);
  const viewingCurrent = selectedVersion === currentVersion;
  document.getElementById('secretData').readOnly = !viewingCurrent;
  document.getElementById('convert-format').disabled = !viewingCurrent;
  document.getElementById('convert-case').disabled = !viewingCurrent;
  document.getElementById('save').disabled = !viewingCurrent;
  document.getElementById('delete').disabled = !viewingCurrent;
  updateVersionHistorySelection();
  updateSelectedVersionMetadata();
  showInfo(viewingCurrent ? '' : 'Viewing an older version. Select the current version to edit or delete.');
}

versionSelect.addEventListener('change', async () => {
  if (!loadedSecretPath) return;
  try {
    await loadSecretVersion(loadedSecretPath, Number(versionSelect.value));
  } catch (error) { showError(error.message); }
});

secretVersionHistoryRows.addEventListener('click', async event => {
  const button = event.target.closest('button[data-version]');
  if (!button || !loadedSecretPath || button.disabled) return;
  try {
    await loadSecretVersion(loadedSecretPath, Number(button.dataset.version));
    selectSecretTab('secret');
  } catch (error) { showError(error.message); }
});

secretTabs.addEventListener('click', event => {
  const button = event.target.closest('[role="tab"]');
  if (!button) return;
  selectSecretTab(button.id === 'metadataTab' ? 'metadata' : button.id === 'pathsTab' ? 'paths' : button.id === 'historyTab' ? 'history' : 'secret');
});

secretTabs.addEventListener('keydown', event => {
  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
  const buttons = Array.from(secretTabs.querySelectorAll('[role="tab"]'));
  const current = buttons.indexOf(document.activeElement);
  if (current < 0) return;
  let next = current;
  if (event.key === 'ArrowLeft') next = (current - 1 + buttons.length) % buttons.length;
  if (event.key === 'ArrowRight') next = (current + 1) % buttons.length;
  if (event.key === 'Home') next = 0;
  if (event.key === 'End') next = buttons.length - 1;
  event.preventDefault();
  buttons[next].click();
  buttons[next].focus();
});

document.querySelectorAll('[data-copy-target]').forEach(button => {
  button.addEventListener('click', async () => {
    const target = document.getElementById(button.dataset.copyTarget);
    try {
      await navigator.clipboard.writeText(target.textContent);
      showSuccess('Copied to clipboard');
    } catch (error) {
      showError('Copy failed. Select the text and copy it manually.');
    }
  });
});

secretPathInput.addEventListener('input', updatePathDisplay);
secretMountSelect.addEventListener('change', () => {
  currentMount = secretMountSelect.value;
  clearVersionControls();
  document.getElementById('secretData').value = '';
  refresh().then(() => {
    if (currentSecretPath()) openSecret(currentSecretPath());
  });
  const params = new URLSearchParams({mount:currentMount});
  if (currentSecretPath()) params.set('path', currentSecretPath());
  history.replaceState(null, '', '/secret.html?' + params);
});

function parseDotenv(content) {
  const data = {};
  for (const rawLine of content.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith('#')) continue;
    const match = line.match(/^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$/);
    if (!match) throw new Error('Invalid dotenv line: ' + rawLine);
    let value = match[2].trim();
    if (value.length >= 2 && ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'")))) {
      value = value.slice(1, -1);
    } else {
      value = value.replace(/\s+#.*$/, '');
    }
    if (Object.prototype.hasOwnProperty.call(data, match[1])) {
      throw new Error('Duplicate dotenv key: ' + match[1]);
    }
    data[match[1]] = value;
  }
  return data;
}

function toDotenv(data) {
  return Object.keys(data).sort().map(key => {
    const rawValue = typeof data[key] === 'string' ? data[key] : JSON.stringify(data[key]);
    const escaped = rawValue.replace(/\\/g, '\\\\').replace(/\n/g, '\\n').replace(/"/g, '\\"');
    return key + '="' + escaped + '"';
  }).join('\n');
}

function parseEditorData() {
  const content = document.getElementById('secretData').value.trim();
  if (!content) throw new Error('Secret content is required');
  try {
    const data = JSON.parse(content);
    if (data === null || Array.isArray(data) || typeof data !== 'object') {
      throw new Error('JSON secret must be an object');
    }
    return {data, format: 'json'};
  } catch (error) {
    if (error instanceof SyntaxError) {
      const dotenv = parseDotenv(content);
      if (Object.keys(dotenv).length === 0) throw new Error('Content is neither valid JSON nor dotenv');
      return {data: dotenv, format: 'dotenv'};
    }
    throw error;
  }
}

function validateEditorData(parsed) {
  const keys = Object.keys(parsed.data);
  if (keys.length === 0) {
    throw new Error('Secret must contain at least one key');
  }
  for (const key of keys) {
    if (!key.trim()) throw new Error('Secret keys cannot be empty');
    if (parsed.format === 'dotenv' && !/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
      throw new Error('Invalid dotenv key: ' + key);
    }
    if (parsed.data[key] === undefined) {
      throw new Error('Secret value is invalid for key: ' + key);
    }
  }
  return parsed.data;
}

function validateSecretPath(path) {
  if (!path) throw new Error('Secret name is required');
  const segments = path.split('/');
  if (segments.some(segment => segment.length < 1 || segment.length > 127)) {
    throw new Error('Each secret name segment must be 1–127 characters');
  }
  if (segments.some(segment => !/^[A-Za-z0-9-]+$/.test(segment))) {
    throw new Error('Secret names may contain only letters, numbers, and hyphens');
  }
  return path;
}

document.getElementById('convert-format').addEventListener('click', () => {
  try {
    const editor = document.getElementById('secretData');
    const parsed = parseEditorData();
    if (parsed.format === 'json') {
      const data = parsed.data;
      editor.value = toDotenv(data);
      showSuccess('Converted to dotenv');
    } else {
      editor.value = JSON.stringify(parsed.data, null, 2);
      showSuccess('Converted to JSON');
    }
  } catch (error) {
    showError(error.message);
  }
});

document.getElementById('convert-case').addEventListener('click', () => {
  try {
    const parsed = parseEditorData();
    const data = parsed.data;
    const keys = Object.keys(data);
    if (keys.length === 0) throw new Error('Secret has no keys to convert');
    const convertToLower = keys.every(key => key === key.toUpperCase());
    const converted = {};
    for (const [key, value] of Object.entries(data)) {
      const nextKey = convertToLower ? key.toLowerCase() : key.toUpperCase();
      if (Object.prototype.hasOwnProperty.call(converted, nextKey)) {
        throw new Error('Key case conversion would create duplicate key: ' + nextKey);
      }
      converted[nextKey] = value;
    }
    document.getElementById('secretData').value = parsed.format === 'json'
      ? JSON.stringify(converted, null, 2)
      : toDotenv(converted);
    showSuccess(convertToLower ? 'Converted keys to lowercase' : 'Converted keys to uppercase');
  } catch (error) {
    showError(error.message);
  }
});

document.getElementById('save').addEventListener('click', async () => {
  const path = currentSecretPath().trim().replace(/^\/+/, '').replace(/\/+$/, '');
  try {
    if (loadedSecretPath === path && selectedVersion !== currentVersion) {
      throw new Error('Select the current version before saving');
    }
    validateSecretPath(path);
    const data = validateEditorData(parseEditorData());
    if (!path) throw new Error('Secret path is required');
    const result = await api(secretAPI(path), {method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({data})});
    await refresh();
    await openSecret(path);
    showSuccess('Saved as version ' + result.version);
  } catch (error) { showError(error.message); }
});

document.getElementById('delete').addEventListener('click', async () => {
  const path = currentSecretPath().trim();
  if (loadedSecretPath === path && selectedVersion !== currentVersion) return;
  if (!path || !confirm('Delete ' + path + '?')) return;
  try {
    await api(secretAPI(path), {method:'DELETE'});
    const separator = path.lastIndexOf('/');
    const parent = separator >= 0 ? path.slice(0, separator) : '';
    location.assign('/secrets.html?mount=' + encodeURIComponent(currentMount) + '&group=' + encodeURIComponent(parent));
  } catch (error) { showError(error.message); }
});

async function openInitialSecret() {
  try {
    const result = await api('/v1/mounts');
    allowedMounts = result.mounts;
    secretMountSelect.replaceChildren();
    allowedMounts.forEach(mount => {
      const option = document.createElement('option');
      option.value = mount;
      option.textContent = mount;
      secretMountSelect.append(option);
    });
    if (!allowedMounts.includes(currentMount)) currentMount = allowedMounts[0] || '';
    secretMountSelect.value = currentMount;
    if (!currentMount) {
      document.getElementById('save').disabled = true;
      document.getElementById('delete').disabled = true;
      showError('No engines are available to this account.');
      return;
    }
    await refresh();
    const path = new URLSearchParams(location.search).get('path');
    if (path) await openSecret(path);
    else {
      renderPaths('');
      renderBreadcrumb('');
    }
  } catch (error) {
    showError(error.message);
  }
}

openInitialSecret();
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
