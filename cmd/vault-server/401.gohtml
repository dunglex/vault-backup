<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>401 Unauthorized - Vault Server</title>
  <style>
    :root { color-scheme: dark; --bg:#0b1020; --panel:#151d31; --line:#293450; --text:#edf2ff; --muted:#9da9c3; --accent:#64d2a8; }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; background:var(--bg); color:var(--text); font:15px/1.5 system-ui,sans-serif; }
    main { width:min(100% - 32px, 520px); background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:32px; text-align:center; }
    .code { margin:0; color:var(--accent); font-size:72px; line-height:1; }
    h1 { margin:16px 0 8px; }
    p { color:var(--muted); }
    a { display:inline-block; margin-top:12px; padding:10px 16px; border-radius:7px; background:var(--accent); color:#07150f; font-weight:700; text-decoration:none; }
  </style>
</head>
<body>
<main>
  <p class="code">401</p>
  <h1>Unauthorized</h1>
  <p>Your session is missing or has expired. Sign in to continue.</p>
  <a href="/login">Go to login</a>
</main>
</body>
</html>
