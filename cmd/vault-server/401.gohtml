<body class="status-page">
<main class="panel status-card">
  <p class="status-code">401</p>
  <h1>Unauthorized</h1>
  <p class="muted">Your session is missing or has expired. Sign in to continue.</p>
  <a class="button" href="/login.html">Go to login</a>
</main>
</body>
</html>
