<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Browse secrets - Vault Server</title>
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/notyf.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        {{if .IsAdmin}}<a class="button button-outline" href="/mounts.html">Engines</a>{{end}}
        <a class="button" aria-current="page" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API</a>
        <a class="button button-outline" href="/audits.html">Audit</a>
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>

  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <div class="secret-browser-header">
      <h2 class="section-label">Secrets</h2>
      <a class="button button-outline" href="/secret.html">Create secret</a>
    </div>
    <label for="mountSelect">Engine</label>
    <select id="mountSelect"></select>
    <p id="secret-summary" class="muted"></p>
    <ul id="secret-list" class="secret-list"></ul>
    <div class="row-actions secret-pager">
      <label class="page-size-label">Items per page
        <select id="page-size">
          <option value="10">10</option>
          <option value="20" selected>20</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </label>
      <button id="previous" class="button button-outline">Previous</button>
      <button id="next" class="button button-outline">Next</button>
      <span id="page-summary" class="muted"></span>
    </div>
  </section>
</main>
<script src="/notyf.js"></script>
<script src="/notifications.js"></script>
<script src="/api-loading.js"></script>
<script>
const errorBox = document.getElementById('error');
let selectedMount = new URLSearchParams(location.search).get('mount') || 'kv';
let offset = 0;
let limit = 20;

async function api(url, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}

async function refresh() {
  const params = new URLSearchParams({limit, offset, all:'true'});
  try {
    params.set('mount', selectedMount);
    const result = await api('/v1/secrets-browser?' + params);
    document.getElementById('secret-summary').textContent = `${result.total} secret${result.total === 1 ? '' : 's'}`;

    const list = document.getElementById('secret-list');
    list.replaceChildren();
    result.paths.forEach(path => {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = '/secret.html?mount=' + encodeURIComponent(selectedMount) + '&path=' + encodeURIComponent(path);
      link.textContent = path;
      item.appendChild(link);
      list.appendChild(item);
    });

    const first = result.total === 0 ? 0 : result.offset + 1;
    const last = result.offset + result.paths.length;
    document.getElementById('page-summary').textContent = `${first}-${last} of ${result.total}`;
    document.getElementById('previous').disabled = result.offset === 0;
    document.getElementById('next').disabled = last >= result.total;
    errorBox.textContent = '';
  } catch (error) {
    errorBox.textContent = error.message;
  }
}

document.getElementById('previous').onclick = () => {
  offset = Math.max(0, offset - limit);
  refresh();
};
document.getElementById('next').onclick = () => {
  offset += limit;
  refresh();
};
document.getElementById('page-size').onchange = event => {
  limit = Number(event.target.value);
  offset = 0;
  refresh();
};

async function initialize() {
  try {
    const result = await api('/v1/mounts');
    const select = document.getElementById('mountSelect');
    select.replaceChildren();
    result.mounts.forEach(mount => {
      const option = document.createElement('option');
      option.value = mount;
      option.textContent = mount;
      select.append(option);
    });
    if (!result.mounts.includes(selectedMount)) selectedMount = result.mounts[0] || '';
    select.value = selectedMount;
    select.addEventListener('change', () => {
      selectedMount = select.value;
      offset = 0;
      const query = new URLSearchParams({mount:selectedMount});
      history.replaceState(null, '', '/secrets.html?' + query);
      refresh();
    });
    if (selectedMount) await refresh();
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
initialize();
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
