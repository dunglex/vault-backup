<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>API Tokens - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/notyf.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Admin navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        {{if .IsAdmin}}<a class="button button-outline" href="/mounts.html">Engines</a>{{end}}
        <a class="button button-outline" href="/secrets.html">Secrets</a>
        <a class="button" aria-current="page" href="/tokens.html">API</a>
        <a class="button button-outline" href="/audits.html">Audit</a>
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button button-outline" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <div class="token-page-header">
      <h2 class="section-label">API tokens</h2>
      <button id="openCreateToken" type="button" {{if not .IsAdmin}}disabled{{end}}>Add token</button>
    </div>
    <ul id="tokens"></ul>
  </section>
</main>
<dialog id="createTokenDialog" class="admin-dialog" aria-labelledby="createTokenTitle">
  <form id="createTokenForm">
    <div class="admin-dialog-heading">
      <h2 id="createTokenTitle">Add API token</h2>
      <button id="closeCreateToken" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <div id="tokenFormFields">
      <label for="tokenName">Token name</label>
      <input id="tokenName" name="name" maxlength="128" autocomplete="off" required>
      <label for="tokenLifetimeDays">Token lifetime</label>
      <select id="tokenLifetimeDays" name="expires_in_days" required>
        <option value="30" selected>30 days</option>
        <option value="60">60 days</option>
        <option value="90">90 days</option>
        <option value="180">180 days</option>
        <option value="365">365 days</option>
      </select>
      <label for="tokenMounts">Allowed engines</label>
      <select id="tokenMounts" name="mounts" multiple required size="5"></select>
      {{if not .IsAdmin}}<p class="muted">Only engines assigned to your operator account are available.</p>{{end}}
      <p class="muted">Each selected engine grants access to all its secret paths.</p>
      {{if .EnforceMTLS}}<p class="muted">The client certificate expires at the same time as the token.</p>{{end}}
    </div>
    <p id="dialogError" class="notice" role="alert"></p>
    <p id="credentialNotice" class="muted" hidden></p>
    <section id="tokenCopyPanel" class="credential-panel" aria-label="New API token" hidden>
      <p class="credential-label">API token (shown once)</p>
      <div class="credential-copy-row">
        <code id="tokenValue" class="credential-value"></code>
        <button id="copyToken" class="button button-outline" type="button">Copy token</button>
      </div>
      <span id="copyTokenStatus" class="success" role="status"></span>
    </section>
    <div id="credentialDownloads" class="row-actions" hidden></div>
    <section id="sampleCommandPanel" class="credential-panel" hidden>
      <h3 id="sampleCommandTitle">Sample vault-backup command</h3>
      <div class="credential-copy-row">
        <pre id="sampleCommand"><code></code></pre>
      </div>
    </section>
    <div class="row-actions admin-dialog-actions">
      <button id="createToken" type="submit">Create token</button>
      <button id="finishCreateToken" type="button" hidden>Done</button>
    </div>
  </form>
</dialog>
<dialog id="editTokenMountsDialog" class="admin-dialog" aria-labelledby="editTokenMountsTitle">
  <form id="editTokenMountsForm">
    <div class="admin-dialog-heading">
      <h2 id="editTokenMountsTitle">Edit token access</h2>
      <button id="closeEditTokenMounts" class="button button-outline" type="button">Close</button>
    </div>
    <div id="editTokenMountsError" class="notice" role="alert"></div>
    <label for="editTokenMounts">Allowed engines</label>
    <select id="editTokenMounts" multiple required size="5"></select>
    <div class="row-actions admin-dialog-actions">
      <button type="submit">Save access</button>
    </div>
  </form>
</dialog>
<script src="/notyf.js"></script>
<script src="/notifications.js"></script>
<script src="/api-loading.js"></script>
<script>
const enforceMTLS = {{if .EnforceMTLS}}true{{else}}false{{end}};
const isAdmin = {{if .IsAdmin}}true{{else}}false{{end}};
const errorBox = document.getElementById('error');
const createDialog = document.getElementById('createTokenDialog');
const editMountsDialog = document.getElementById('editTokenMountsDialog');
let apiTokens = [];
let newCredentials = null;
let editingTokenId = 0;
let allowedMounts = [];

function showError(message) { errorBox.textContent = message || ''; }
function readMountValues(id) {
  return Array.from(document.getElementById(id).selectedOptions, option => option.value);
}
function setMountValues(id, mounts) {
  const control = document.getElementById(id);
  for (const option of control.options) option.selected = mounts.includes(option.value);
}
function populateMountChoices(id) {
  const select = document.getElementById(id);
  select.replaceChildren();
  for (const mount of allowedMounts) {
    const option = document.createElement('option');
    option.value = mount;
    option.textContent = mount;
    select.append(option);
  }
}
function sampleCommand(mount) {
  return [
    'export VAULT_TOKEN="PASTE_COPIED_TOKEN_HERE"',
    './bin/vault-backup \\',
    '  --url https://vault.example:8200/api \\',
    '  --token "$VAULT_TOKEN" \\',
    '  --ca_cert /path/to/vault-server-ca.pem \\',
    '  --client_cert ./vault-client-cert.pem \\',
    '  --client_key ./vault-client-key.pem \\',
    '  --secret_name ' + mount + ' \\',
    '  --secret_path app/database \\',
    '  --output_mode file \\',
    '  --output_format env \\',
    '  --output_path ./database.env'
  ].join('\n');
}
async function copyText(text, statusId, button) {
  const status = document.getElementById(statusId);
  button.disabled = true;
  status.textContent = '';
  try {
    await navigator.clipboard.writeText(text);
    status.textContent = 'Copied.';
  } catch (error) {
    status.textContent = 'Copy failed. Select the text and copy it manually.';
  } finally {
    button.disabled = false;
  }
}
function downloadCredential(filename, contents) {
  const link = document.createElement('a');
  const url = URL.createObjectURL(new Blob([contents], {type:'application/x-pem-file'}));
  link.href = url;
  link.download = filename;
  link.click();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}
function showCreatedCredentials(certificate, privateKey, token, mount) {
  const hasCertificate = enforceMTLS && Boolean(certificate && privateKey);
  const credentialDownloads = document.getElementById('credentialDownloads');
  credentialDownloads.replaceChildren();
  credentialDownloads.hidden = true;
  newCredentials = {
    certificate: hasCertificate ? certificate : null,
    privateKey: hasCertificate ? privateKey : null,
    hasCertificate,
    hasToken: Boolean(token)
  };
  if (hasCertificate) {
    const certificateButton = document.createElement('button');
    certificateButton.id = 'downloadClientCert';
    certificateButton.className = 'button button-outline';
    certificateButton.type = 'button';
    certificateButton.textContent = 'Download client certificate';
    certificateButton.onclick = () => downloadCredential('vault-client-cert.pem', newCredentials.certificate);
    const privateKeyButton = document.createElement('button');
    privateKeyButton.id = 'downloadClientKey';
    privateKeyButton.className = 'button button-outline';
    privateKeyButton.type = 'button';
    privateKeyButton.textContent = 'Download private key';
    privateKeyButton.onclick = () => downloadCredential('vault-client-key.pem', newCredentials.privateKey);
    credentialDownloads.append(certificateButton, privateKeyButton);
    credentialDownloads.hidden = false;
    const sampleMount = mount || readMountValues('tokenMounts')[0] || allowedMounts[0];
    const samplePanel = document.getElementById('sampleCommandPanel');
    samplePanel.hidden = !sampleMount;
    if (sampleMount) {
      document.getElementById('sampleCommand').querySelector('code').textContent = sampleCommand(sampleMount);
    }
  }
  const tokenPanel = document.getElementById('tokenCopyPanel');
  tokenPanel.hidden = !token;
  if (token) {
    document.getElementById('tokenValue').textContent = token;
    document.getElementById('copyTokenStatus').textContent = '';
  }
  document.getElementById('credentialNotice').hidden = !(hasCertificate || token);
}
async function api(url, options = {}) {
  options.headers = options.headers || {};
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}

async function refreshTokens() {
  try {
    apiTokens = await api('/v1/tokens');
    renderTokens();
  } catch (error) { showError(error.message); }
}

function renderTokens() {
  const list = document.getElementById('tokens');
  list.replaceChildren();
  apiTokens.forEach(token => {
    const li = document.createElement('li');
    const state = token.revoked ? 'revoked' : token.expired ? 'expired' : 'active';
    const details = document.createElement('span');
    const certificate = !enforceMTLS ? '' : token.has_certificate
      ? 'client cert expires ' + token.certificate_expires_at
      : 'no client certificate';
    details.textContent = token.name + ' (' + state + ', token expires ' + token.expires_at
      + (certificate ? '; ' + certificate : '') + '; allowed engines: '
      + (token.mounts.length ? token.mounts.join(', ') : 'none') + ')';
    li.appendChild(details);
    const actions = document.createElement('div');
    actions.className = 'row-actions token-actions';
    const editMounts = document.createElement('button');
    editMounts.className = 'button button-outline';
    editMounts.textContent = 'Edit engines';
    editMounts.type = 'button';
    editMounts.onclick = () => {
      editingTokenId = token.id;
      document.getElementById('editTokenMountsTitle').textContent = `Edit engines for ${token.name}`;
      document.getElementById('editTokenMountsError').textContent = '';
      setMountValues('editTokenMounts', token.mounts);
      editMountsDialog.showModal();
    };
    actions.appendChild(editMounts);
    if (!token.revoked && !token.expired) {
      if (enforceMTLS) {
        const certificateButton = document.createElement('button');
        certificateButton.className = 'button button-outline';
        certificateButton.textContent = token.has_certificate ? 'Replace certificate' : 'Issue certificate';
        certificateButton.type = 'button';
        certificateButton.onclick = async () => {
          certificateButton.disabled = true;
          try {
            const result = await api('/v1/tokens/' + token.id + '/certificate', {method:'POST'});
            document.getElementById('createTokenTitle').textContent = 'Client certificate issued';
            document.getElementById('tokenFormFields').hidden = true;
            document.getElementById('credentialNotice').textContent = 'Download and protect these files now. The private key is not stored for later download.';
            document.getElementById('createToken').hidden = true;
            document.getElementById('finishCreateToken').hidden = false;
            showCreatedCredentials(result.client_certificate, result.client_private_key, null, token.mounts[0]);
            createDialog.showModal();
            await refreshTokens();
          } catch (error) {
            showError(error.message);
          } finally {
            certificateButton.disabled = false;
          }
        };
        actions.appendChild(certificateButton);
      }
      const button = document.createElement('button');
      button.className = 'danger';
      button.textContent = 'Revoke';
      button.type = 'button';
      button.onclick = async () => {
        try {
          await api('/v1/tokens/' + token.id, {method:'DELETE'});
          await refreshTokens();
        } catch (error) { showError(error.message); }
      };
      actions.appendChild(button);
    }
    li.appendChild(actions);
    list.appendChild(li);
  });
}

document.getElementById('openCreateToken').addEventListener('click', () => {
  document.getElementById('createTokenTitle').textContent = 'Add API token';
  document.getElementById('dialogError').textContent = '';
  document.getElementById('credentialNotice').textContent = '';
  document.getElementById('credentialNotice').hidden = true;
  document.getElementById('tokenCopyPanel').hidden = true;
  document.getElementById('credentialDownloads').replaceChildren();
  document.getElementById('credentialDownloads').hidden = true;
  document.getElementById('sampleCommandPanel').hidden = true;
  newCredentials = null;
  document.getElementById('tokenFormFields').hidden = false;
  document.getElementById('closeCreateToken').disabled = false;
  document.getElementById('createToken').hidden = false;
  document.getElementById('finishCreateToken').hidden = true;
  createDialog.showModal();
  document.getElementById('tokenName').focus();
});

function closeWithConfirmation() {
  if (newCredentials) {
    const message = newCredentials.hasToken && newCredentials.hasCertificate
      ? 'Have you copied the token and downloaded both credential files? The token cannot be shown again after closing.'
      : newCredentials.hasToken
        ? 'Have you copied the token? It cannot be shown again after closing.'
        : 'Have you downloaded and protected both credential files? Closing clears the private key from this page.';
    if (!window.confirm(message)) return;
  }
  createDialog.close();
}
document.getElementById('closeCreateToken').addEventListener('click', closeWithConfirmation);
document.getElementById('finishCreateToken').addEventListener('click', closeWithConfirmation);
createDialog.addEventListener('close', () => {
  document.getElementById('tokenName').value = '';
  document.getElementById('tokenLifetimeDays').value = '30';
  setMountValues('tokenMounts', []);
  document.getElementById('credentialNotice').textContent = '';
  document.getElementById('credentialNotice').hidden = true;
  document.getElementById('dialogError').textContent = '';
  document.getElementById('tokenValue').textContent = '';
  document.getElementById('copyTokenStatus').textContent = '';
  document.getElementById('sampleCommand').querySelector('code').textContent = '';
  document.getElementById('tokenCopyPanel').hidden = true;
  document.getElementById('credentialDownloads').replaceChildren();
  document.getElementById('credentialDownloads').hidden = true;
  document.getElementById('sampleCommandPanel').hidden = true;
  document.getElementById('tokenFormFields').hidden = false;
  document.getElementById('createToken').hidden = false;
  document.getElementById('finishCreateToken').hidden = true;
  document.getElementById('closeCreateToken').disabled = false;
  newCredentials = null;
});
createDialog.addEventListener('cancel', event => {
  event.preventDefault();
});
window.addEventListener('beforeunload', event => {
  if (createDialog.open) {
    event.preventDefault();
    event.returnValue = '';
  }
});
document.getElementById('copyToken').addEventListener('click', event => {
  copyText(document.getElementById('tokenValue').textContent, 'copyTokenStatus', event.currentTarget);
});

document.getElementById('createTokenForm').addEventListener('submit', async event => {
  event.preventDefault();
  const name = document.getElementById('tokenName').value.trim();
  const createButton = document.getElementById('createToken');
  const closeButton = document.getElementById('closeCreateToken');
  const dialogError = document.getElementById('dialogError');
  dialogError.textContent = '';
  createButton.disabled = true;
  closeButton.disabled = true;
  try {
    const result = await api('/v1/tokens', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        name,
        expires_in_days:Number(document.getElementById('tokenLifetimeDays').value),
        mounts:readMountValues('tokenMounts')
      })
    });
    document.getElementById('createTokenTitle').textContent = 'Token created';
    document.getElementById('tokenFormFields').hidden = true;
    const hasCertificate = Boolean(result.client_certificate && result.client_private_key);
    document.getElementById('credentialNotice').textContent = hasCertificate
      ? 'Copy the token and download both credential files now. The token will not be shown again.'
      : 'Copy the token now. It will not be shown again after closing.';
    showCreatedCredentials(result.client_certificate, result.client_private_key, result.token, readMountValues('tokenMounts')[0]);
    createButton.hidden = true;
    document.getElementById('finishCreateToken').hidden = false;
    await refreshTokens();
  } catch (error) {
    dialogError.textContent = error.message;
  } finally {
    createButton.disabled = false;
    closeButton.disabled = false;
  }
});


async function initializeTokenPage() {
  try {
    const result = await api('/v1/mounts');
    allowedMounts = result.mounts;
    populateMountChoices('tokenMounts');
    populateMountChoices('editTokenMounts');
    if (!isAdmin) {
      document.getElementById('openCreateToken').disabled = false;
    }
  } catch (error) {
    showError(error.message);
  }
  await refreshTokens();
}
initializeTokenPage();
document.getElementById('closeEditTokenMounts').addEventListener('click', () => editMountsDialog.close());
document.getElementById('editTokenMountsForm').addEventListener('submit', async event => {
  event.preventDefault();
  const error = document.getElementById('editTokenMountsError');
  error.textContent = '';
  try {
    await api('/v1/tokens/' + editingTokenId + '/mounts', {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        mounts:readMountValues('editTokenMounts')
      })
    });
    editMountsDialog.close();
    await refreshTokens();
  } catch (failure) {
    error.textContent = failure.message;
  }
});
</script>
<script>
const appNav = document.querySelector('.app-nav');
const appNavToggle = appNav.querySelector('.app-nav-toggle');

function closeAppNav() {
  appNavToggle.setAttribute('aria-expanded', 'false');
  appNavToggle.setAttribute('aria-label', 'Open navigation menu');
}

appNavToggle.addEventListener('click', () => {
  const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
  appNavToggle.setAttribute('aria-expanded', String(!expanded));
  appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
});

document.addEventListener('click', event => {
  if (!appNav.contains(event.target)) closeAppNav();
});

document.addEventListener('keydown', event => {
  if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
    closeAppNav();
    appNavToggle.focus();
  }
});
</script>
</body>
</html>
