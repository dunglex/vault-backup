<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Account - Vault Server</title>
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Account navigation">
      <button class="app-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-nav-links">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24">
          <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
      </button>
      <div id="app-nav-links" class="app-nav-links">
        <a class="button button-outline" href="/secrets.html">Secrets</a>
        <a class="button button-outline" href="/tokens.html">API tokens</a>
        <a class="button button-outline" href="/audits.html">Audit log</a>
        {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
        {{if and .IsAdmin .HasBackup}}<a class="button button-outline" href="/backup.html">Backup</a>{{end}}
        {{if .IsAdmin}}<a class="button button-outline" href="/security.html">Security</a>{{end}}
        <a class="button" aria-current="page" href="/account.html">Account</a>
      </div>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <p id="passwordChangeRequiredNotice" class="notice" role="alert" hidden>Your administrator created a temporary password for this account. Change it before continuing.</p>
  <section id="totpSetupPanel" class="panel" hidden>
    <h2 class="section-label">Two-factor authentication</h2>
    <p id="totpDescription">Authenticator-based two-factor sign-in is optional and disabled by default. When enabled, sign-in requires your password and a current authenticator code or an unused recovery code.</p>
    <p id="mfaEnforcementNotice" class="notice" role="status" hidden>Your administrator requires MFA. Enroll an authenticator before accessing the rest of the application.</p>
    <div class="row-actions totp-setup-actions">
      <button id="openTOTPSetup" type="button">Setup 2FA</button>
    </div>
  </section>
  <dialog id="totpSetupDialog" class="admin-dialog" aria-labelledby="totpSetupTitle">
    <div class="admin-dialog-heading">
      <h2 id="totpSetupTitle">Set up two-factor authentication</h2>
      <button id="closeTOTPSetup" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <div id="setupDialogError" class="notice" role="alert"></div>
    <button id="setupTOTP" type="button">Generate authenticator secret</button>
    <div id="totpPendingPanel" class="credential-panel" hidden>
      <h3>Add this account to your authenticator app</h3>
      <p>Scan this QR code with your authenticator app, then enter the code it generates:</p>
      <div id="totpQRCode" class="totp-qr-code" role="img" aria-label="Authenticator setup QR code"></div>
      <p>Choose time-based one-time password (TOTP), then enter this secret manually:</p>
      <p><code id="totpSecret" class="credential-value"></code></p>
      <form id="enableForm">
        <label for="enableCode">Authenticator code</label>
        <input id="enableCode" inputmode="numeric" autocomplete="one-time-code" minlength="6" maxlength="6" required>
        <button id="enableTOTP" type="submit">Verify and enable</button>
      </form>
    </div>
  </dialog>
  <section id="totpEnabledPanel" class="panel" hidden>
    <h2 class="section-label">Two-factor authentication enabled</h2>
    <p id="mfaEnforcedStatus" class="muted" hidden>Your administrator requires MFA. Two-factor authentication cannot be disabled while enforcement is on.</p>
    <p id="recoveryCodeCount" class="muted"></p>
    <button id="openRecoveryCodesDialog" class="button button-outline" type="button">Show backup recovery codes</button>
    <button id="openDisableTOTPDialog" class="button button-outline" type="button">Disable two-factor authentication</button>
  </section>
  <dialog id="disableTOTPDialog" class="admin-dialog" aria-labelledby="disableTOTPTitle">
    <div class="admin-dialog-heading">
      <h2 id="disableTOTPTitle">Disable two-factor authentication</h2>
      <button id="closeDisableTOTPDialog" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <p class="muted">Confirm your password and authenticator or recovery code to disable two-factor sign-in.</p>
    <div id="disableDialogError" class="notice" role="alert"></div>
    <form id="disableForm">
      <label for="disablePassword">Current password</label>
      <input id="disablePassword" type="password" autocomplete="current-password" required>
      <label for="disableCode">Authenticator or recovery code</label>
      <input id="disableCode" autocomplete="one-time-code" required>
      <div class="row-actions admin-dialog-actions">
        <button id="cancelDisableTOTP" class="button button-outline" type="button">Cancel</button>
        <button id="disableTOTP" type="submit">Disable 2FA</button>
      </div>
    </form>
  </dialog>
  <dialog id="recoveryCodesDialog" class="admin-dialog" aria-labelledby="recoveryCodesTitle">
    <div class="admin-dialog-heading">
      <h2 id="recoveryCodesTitle">Backup recovery codes</h2>
      <button id="closeRecoveryCodesDialog" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <section id="regenerateRecoveryCodesPanel" hidden>
      <p>Recovery codes are stored as hashes and cannot be retrieved. Generating a new set invalidates all previous codes.</p>
      <form id="regenerateRecoveryCodesForm">
        <div id="regenerateRecoveryCodesError" class="notice" role="alert"></div>
        <label for="recoveryCodesPassword">Current password</label>
        <input id="recoveryCodesPassword" type="password" autocomplete="current-password" required>
        <label for="recoveryCodesFactor">Authenticator or unused recovery code</label>
        <input id="recoveryCodesFactor" autocomplete="one-time-code" required>
        <div class="row-actions admin-dialog-actions">
          <button id="regenerateRecoveryCodes" type="submit">Generate new codes</button>
        </div>
      </form>
    </section>
    <section id="recoveryCodesDisplay" hidden>
      <p id="recoveryCodesDescription" class="muted"></p>
      <ul id="recoveryCodes"></ul>
      <div class="row-actions admin-dialog-actions">
        <button id="dismissRecoveryCodes" type="button">I saved these codes</button>
      </div>
    </section>
  </dialog>
  <section class="panel">
    <h2 class="section-label">Change password</h2>
    <button id="openPasswordDialog" type="button">Change password</button>
    <p id="passwordStatus" role="status" class="muted"></p>
  </section>
  <dialog id="passwordDialog" class="admin-dialog" aria-labelledby="passwordDialogTitle">
    <div class="admin-dialog-heading">
      <h2 id="passwordDialogTitle">Change password</h2>
      <button id="closePasswordDialog" class="button button-outline" type="button" aria-label="Close dialog">Close</button>
    </div>
    <div id="passwordDialogError" class="notice" role="alert"></div>
    <form id="passwordForm">
      <label for="currentPassword">Current password</label>
      <input id="currentPassword" type="password" autocomplete="current-password" required>
      <label for="newPassword">New password</label>
      <input id="newPassword" type="password" autocomplete="new-password" minlength="12" required>
      <label for="repeatNewPassword">Repeat new password</label>
      <input id="repeatNewPassword" type="password" autocomplete="new-password" minlength="12" required>
      <p class="muted">New passwords must be at least 12 characters and no more than 72 bytes.</p>
      <div class="row-actions admin-dialog-actions">
        <button id="changePassword" type="submit">Change password</button>
      </div>
    </form>
  </dialog>
  <section class="panel">
    <h2 class="section-label">Session</h2>
    <p>Sign out of this account on this browser.</p>
    <button id="logout" class="button button-outline" type="button">Logout</button>
  </section>
</main>
<script src="/qrcode.js"></script>
<script src="/api-loading.js"></script>
<script>
const errorBox = document.getElementById('error');
const setupDialog = document.getElementById('totpSetupDialog');
const setupDialogError = document.getElementById('setupDialogError');
const passwordDialog = document.getElementById('passwordDialog');
const passwordDialogError = document.getElementById('passwordDialogError');
const recoveryCodesDialog = document.getElementById('recoveryCodesDialog');
const disableTOTPDialog = document.getElementById('disableTOTPDialog');
const disableDialogError = document.getElementById('disableDialogError');
let mfaSetupRequired = new URLSearchParams(location.search).get('mfa') === 'required';
let passwordChangeRequired = new URLSearchParams(location.search).get('password') === 'required';
let pendingTOTPProvisioningURI = '';
async function api(url, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401 && body.error === 'unauthorized') location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}
function showRecoveryCodes(codes, regenerated = false) {
  const list = document.getElementById('recoveryCodes');
  list.replaceChildren();
  for (const value of codes) {
    const item = document.createElement('li');
    const code = document.createElement('code');
    code.textContent = value;
    item.append(code);
    list.append(item);
  }
  document.getElementById('regenerateRecoveryCodesPanel').hidden = true;
  document.getElementById('recoveryCodesDisplay').hidden = false;
  document.getElementById('recoveryCodesDescription').textContent = regenerated
    ? 'These new codes replace all previous backup codes. Save them now; each code works once.'
    : 'Save these codes now. They are shown only once, and each code works once.';
  if (!recoveryCodesDialog.open) recoveryCodesDialog.showModal();
}
async function loadTOTP() {
  errorBox.textContent = '';
  try {
    const state = await api('/v1/account/totp');
    document.getElementById('totpSetupPanel').hidden = state.enabled;
    document.getElementById('totpEnabledPanel').hidden = !state.enabled;
    document.getElementById('mfaEnforcedStatus').hidden = !state.enforced;
    document.getElementById('openDisableTOTPDialog').hidden = state.enforced;
    document.getElementById('mfaEnforcementNotice').hidden = !mfaSetupRequired || state.enabled;
    if (mfaSetupRequired) {
      document.getElementById('totpDescription').textContent = 'Your administrator requires MFA. Sign-in requires your password and a current authenticator code or an unused recovery code.';
    }
    document.getElementById('recoveryCodeCount').textContent =
      `${state.recovery_codes_remaining} recovery codes remain.`;
    const pending = state.setup_pending;
    document.getElementById('totpPendingPanel').hidden = !pending;
    document.getElementById('setupTOTP').textContent = pending
      ? 'Generate a new authenticator secret'
      : 'Set up authenticator';
    pendingTOTPProvisioningURI = pending ? state.provisioning_uri : '';
    if (pending) {
      document.getElementById('totpSecret').textContent = state.secret;
    }
    if (mfaSetupRequired && state.enabled) {
      mfaSetupRequired = false;
      history.replaceState(null, '', '/account.html');
    } else if (mfaSetupRequired) {
      setupDialog.showModal();
      if (pendingTOTPProvisioningURI) renderTOTPQRCode(pendingTOTPProvisioningURI);
    }
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
function renderTOTPQRCode(uri) {
  const container = document.getElementById('totpQRCode');
  container.replaceChildren();
  try {
    new QRCode(container, {
      text: uri,
      width: 220,
      height: 220,
      correctLevel: QRCode.CorrectLevel.M
    });
  } catch (error) {
    setupDialogError.textContent = `Could not display the QR code. Use the manual authenticator secret instead. (${error.message})`;
  }
}
document.getElementById('openTOTPSetup').addEventListener('click', () => {
  setupDialogError.textContent = '';
  setupDialog.showModal();
  if (pendingTOTPProvisioningURI) renderTOTPQRCode(pendingTOTPProvisioningURI);
});
document.getElementById('closeTOTPSetup').addEventListener('click', () => setupDialog.close());
setupDialog.addEventListener('close', () => {
  document.getElementById('enableForm').reset();
  document.getElementById('totpQRCode').replaceChildren();
  setupDialogError.textContent = '';
});
document.getElementById('setupTOTP').addEventListener('click', async () => {
  setupDialogError.textContent = '';
  const button = document.getElementById('setupTOTP');
  button.disabled = true;
  try {
    const result = await api('/v1/account/totp/setup', {
      method:'POST',
    });
    document.getElementById('totpPendingPanel').hidden = false;
    document.getElementById('totpSecret').textContent = result.secret;
    pendingTOTPProvisioningURI = result.provisioning_uri;
    document.getElementById('setupTOTP').textContent = 'Generate a new authenticator secret';
    renderTOTPQRCode(result.provisioning_uri);
    document.getElementById('enableCode').focus();
  } catch (error) {
    setupDialogError.textContent = error.message;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('enableForm').addEventListener('submit', async event => {
  event.preventDefault();
  setupDialogError.textContent = '';
  const button = document.getElementById('enableTOTP');
  button.disabled = true;
  try {
    const result = await api('/v1/account/totp/enable', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({code:document.getElementById('enableCode').value})
    });
    document.getElementById('enableForm').reset();
    setupDialog.close();
    showRecoveryCodes(result.recovery_codes);
    await loadTOTP();
  } catch (error) {
    setupDialogError.textContent = error.message;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('disableForm').addEventListener('submit', async event => {
  event.preventDefault();
  disableDialogError.textContent = '';
  const button = document.getElementById('disableTOTP');
  button.disabled = true;
  try {
    await api('/v1/account/totp', {
      method:'DELETE',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        password:document.getElementById('disablePassword').value,
        code:document.getElementById('disableCode').value
      })
    });
    event.target.reset();
    disableTOTPDialog.close();
    await loadTOTP();
  } catch (error) {
    disableDialogError.textContent = error.message;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('openDisableTOTPDialog').addEventListener('click', () => {
  disableDialogError.textContent = '';
  disableTOTPDialog.showModal();
  document.getElementById('disablePassword').focus();
});
document.getElementById('closeDisableTOTPDialog').addEventListener('click', () => disableTOTPDialog.close());
document.getElementById('cancelDisableTOTP').addEventListener('click', () => disableTOTPDialog.close());
disableTOTPDialog.addEventListener('close', () => {
  document.getElementById('disableForm').reset();
  disableDialogError.textContent = '';
});
document.getElementById('dismissRecoveryCodes').addEventListener('click', () => {
  recoveryCodesDialog.close();
});
document.getElementById('openRecoveryCodesDialog').addEventListener('click', () => {
  document.getElementById('regenerateRecoveryCodesForm').reset();
  document.getElementById('regenerateRecoveryCodesError').textContent = '';
  document.getElementById('recoveryCodesDisplay').hidden = true;
  document.getElementById('regenerateRecoveryCodesPanel').hidden = false;
  recoveryCodesDialog.showModal();
  document.getElementById('recoveryCodesPassword').focus();
});
document.getElementById('closeRecoveryCodesDialog').addEventListener('click', () => recoveryCodesDialog.close());
recoveryCodesDialog.addEventListener('close', () => {
  document.getElementById('recoveryCodes').replaceChildren();
  document.getElementById('regenerateRecoveryCodesForm').reset();
  document.getElementById('regenerateRecoveryCodesError').textContent = '';
  document.getElementById('regenerateRecoveryCodesPanel').hidden = true;
  document.getElementById('recoveryCodesDisplay').hidden = true;
});
document.getElementById('regenerateRecoveryCodesForm').addEventListener('submit', async event => {
  event.preventDefault();
  const error = document.getElementById('regenerateRecoveryCodesError');
  error.textContent = '';
  const button = document.getElementById('regenerateRecoveryCodes');
  button.disabled = true;
  try {
    const result = await api('/v1/account/totp/recovery-codes', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        password:document.getElementById('recoveryCodesPassword').value,
        code:document.getElementById('recoveryCodesFactor').value
      })
    });
    document.getElementById('regenerateRecoveryCodesForm').reset();
    showRecoveryCodes(result.recovery_codes, true);
    await loadTOTP();
  } catch (requestError) {
    error.textContent = requestError.message;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('openPasswordDialog').addEventListener('click', () => {
  passwordDialogError.textContent = '';
  passwordDialog.showModal();
  document.getElementById('currentPassword').focus();
});
document.getElementById('closePasswordDialog').addEventListener('click', () => passwordDialog.close());
passwordDialog.addEventListener('close', () => {
  document.getElementById('passwordForm').reset();
  passwordDialogError.textContent = '';
});
document.getElementById('passwordForm').addEventListener('submit', async event => {
  event.preventDefault();
  passwordDialogError.textContent = '';
  document.getElementById('passwordStatus').textContent = '';
  const button = document.getElementById('changePassword');
  button.disabled = true;
  try {
    await api('/v1/account/password', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        current_password:document.getElementById('currentPassword').value,
        new_password:document.getElementById('newPassword').value,
        repeat_new_password:document.getElementById('repeatNewPassword').value
      })
    });
    event.target.reset();
    passwordDialog.close();
    if (passwordChangeRequired) {
      passwordChangeRequired = false;
      document.getElementById('passwordChangeRequiredNotice').hidden = true;
      for (const id of ['totpSetupPanel', 'totpEnabledPanel']) {
        document.getElementById(id).hidden = false;
      }
      history.replaceState(null, '', '/account.html');
      document.getElementById('passwordStatus').textContent = 'Password changed. You can now continue.';
      await loadTOTP();
    } else {
      document.getElementById('passwordStatus').textContent = 'Password changed.';
    }
  } catch (error) {
    passwordDialogError.textContent = error.message;
  } finally {
    button.disabled = false;
  }
});
document.getElementById('logout').addEventListener('click', async () => {
  if (!window.confirm('Are you sure you want to log out?')) return;
  try { await api('/v1/auth/logout', {method:'POST'}); } catch (_) {}
  location.assign('/login.html');
});
if (passwordChangeRequired) {
  document.getElementById('passwordChangeRequiredNotice').hidden = false;
  document.getElementById('totpSetupPanel').hidden = true;
  document.getElementById('totpEnabledPanel').hidden = true;
  passwordDialog.showModal();
  document.getElementById('currentPassword').focus();
} else {
  loadTOTP();
}
</script>
  <script>
  const appNav = document.querySelector('.app-nav');
  const appNavToggle = appNav.querySelector('.app-nav-toggle');

  function closeAppNav() {
    appNavToggle.setAttribute('aria-expanded', 'false');
    appNavToggle.setAttribute('aria-label', 'Open navigation menu');
  }

  appNavToggle.addEventListener('click', () => {
    const expanded = appNavToggle.getAttribute('aria-expanded') === 'true';
    appNavToggle.setAttribute('aria-expanded', String(!expanded));
    appNavToggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
  });

  document.addEventListener('click', event => {
    if (!appNav.contains(event.target)) closeAppNav();
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && appNavToggle.getAttribute('aria-expanded') === 'true') {
      closeAppNav();
      appNavToggle.focus();
    }
  });
  </script>
</body>
</html>
