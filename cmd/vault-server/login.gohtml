<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login - Vault Server</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,300italic,700,700italic">
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
  <style>
    .login-spinner {
      display: inline-block;
      width: 1.2rem;
      height: 1.2rem;
      margin-right: 0.8rem;
      vertical-align: middle;
      border: 0.2rem solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: login-spin 0.7s linear infinite;
    }
    .login-spinner[hidden] { display: none; }
    @keyframes login-spin {
      to { transform: rotate(360deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .login-spinner { animation-duration: 1.5s; }
    }
  </style>
</head>
<body class="auth-page">
<main class="panel auth-card">
    <h1 class="brand">Vault Server</h1>
    <p class="muted">Sign in to manage secrets and API tokens.</p>
    {{if .AutoBlockLoginIPEnabled}}<p class="notice" role="note">Failed sign-in attempts are recorded with your IP address. Repeated failed attempts may result in this IP being blocked from signing in.</p>{{end}}
    <div id="error" class="notice" role="alert"></div>
    <form id="loginForm">
      <label>Username<input name="username" autocomplete="username" required></label>
      <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
      <label id="totpChallenge" hidden>Authenticator or recovery code
        <input id="totpCode" name="totp_code" autocomplete="one-time-code" disabled required>
      </label>
      <button id="submitLogin" type="submit">
        <span id="loginSpinner" class="login-spinner" aria-hidden="true" hidden></span>
        <span id="loginButtonLabel">Login</span>
      </button>
    </form>
</main>
<script>
const form = document.getElementById('loginForm');
const errorBox = document.getElementById('error');
const totpChallenge = document.getElementById('totpChallenge');
const totpCode = document.getElementById('totpCode');
const submitButton = document.getElementById('submitLogin');
const loginSpinner = document.getElementById('loginSpinner');
const loginButtonLabel = document.getElementById('loginButtonLabel');

form.addEventListener('submit', async event => {
  event.preventDefault();
  if (submitButton.disabled) return;
  errorBox.textContent = '';
  submitButton.disabled = true;
  submitButton.setAttribute('aria-busy', 'true');
  loginSpinner.hidden = false;
  loginButtonLabel.textContent = 'Signing in...';
  try {
    const values = Object.fromEntries(new FormData(form));
    const response = await fetch('/v1/auth/login', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      credentials: 'same-origin',
      body: JSON.stringify(values)
    });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'Login failed');
    if (body.requires_totp) {
      totpChallenge.hidden = false;
      totpCode.disabled = false;
      errorBox.textContent = 'Enter a current authenticator code or an unused recovery code.';
      totpCode.focus();
      return;
    }
    if (body.must_change_password) {
      location.assign(`/account.html?password=required${body.requires_mfa_setup ? '&mfa=required' : ''}`);
      return;
    }
    if (body.requires_mfa_setup) {
      location.assign('/account.html?mfa=required');
      return;
    }
    location.assign('/secrets.html');
  } catch (error) {
    errorBox.textContent = error.message;
  } finally {
    submitButton.disabled = false;
    submitButton.setAttribute('aria-busy', 'false');
    loginSpinner.hidden = true;
    loginButtonLabel.textContent = totpChallenge.hidden ? 'Login' : 'Verify and sign in';
  }
});
</script>
</body>
</html>
