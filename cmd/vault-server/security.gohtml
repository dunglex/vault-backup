<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Security - Vault Server</title>
  <link rel="stylesheet" href="/normalize.css">
  <link rel="stylesheet" href="/miligram.css">
  <link rel="stylesheet" href="/admin.css">
</head>
<body>
<main class="app-shell">
  <header class="app-header">
    <h1 class="brand"><a href="/">Vault Server</a></h1>
    <nav class="app-nav" aria-label="Security navigation">
      <a class="button button-outline" href="/secrets.html">Secrets</a>
      <a class="button button-outline" href="/tokens.html">API tokens</a>
      <a class="button button-outline" href="/audits.html">Audit log</a>
      {{if and .IsAdmin .HasOperators}}<a class="button button-outline" href="/operators.html">Operators</a>{{end}}
      <a class="button" aria-current="page" href="/security.html">Security</a>
      <a class="button button-outline" href="/account.html">Account</a>
    </nav>
  </header>
  <div id="error" class="notice" role="alert"></div>
  <section class="panel">
    <h2 class="section-label">Security settings</h2>
    <p>Mutual TLS enforcement applies to Vault API traffic. Admin pages and health checks remain available without a client certificate. Enforced API requests must use HTTPS; a TLS-terminating proxy must use TLS passthrough or HTTPS to the server.</p>
    <form id="settingsForm">
      <label class="setting-option">
        <input id="enforceMTLS" type="checkbox">
        Enforce mutual TLS for Vault API clients
      </label>
      <p class="muted">Before enabling, issue and install a certificate for every client that needs API access. When enabled, requests must use a valid certificate issued for the same managed API token. Older vault-backup clients will be rejected and must be upgraded.</p>
      <label class="setting-option">
        <input id="enforceMFA" type="checkbox">
        Enforce MFA for all users
      </label>
      <p class="muted">When enabled, users without MFA can only access their account page to enroll. After enrollment, every web and LDAP-compatible login requires an authenticator or recovery code. LDAP-compatible login is unavailable until MFA is enrolled.</p>
      <label class="setting-option">
        <input id="fileLogging" type="checkbox">
        Also write access and error logs to files
      </label>
      <p class="muted">Logs are always written to standard output. When enabled, they are also written to daily log files beside the database and retained for seven days.</p>
      <label class="setting-option">
        <input id="autoBlockLoginBruteforceIP" type="checkbox">
        Auto block login bruteforce IP
      </label>
      <p class="muted">When enabled, an IP address is permanently blocked after five failed logins within ten minutes. Successful logins reset that IP's failure sequence. Blocks remain stored if this option is disabled.</p>
      <label class="setting-option">
        <input id="automaticServerBackup" type="checkbox">
        Enable scheduled server backups
      </label>
      <label for="serverBackupCron">Backup schedule (six-field cron, UTC)</label>
      <input id="serverBackupCron" type="text" maxlength="128" value="0 0 2 * * *" autocomplete="off" spellcheck="false" aria-describedby="serverBackupCronDescription">
      <p id="serverBackupCronDescription" class="muted" aria-live="polite">Every day at 02:00:00 UTC.</p>
      <p class="muted">Format: second minute hour day month weekday (UTC). Default: 02:00 daily. Backups pause service and archive the data folder. Archives older than 30 days are removed after a successful backup. Last successful backup: <span id="lastServerBackup">None</span>.</p>
      <div class="row-actions">
        <button id="viewBlockedIPs" class="button button-outline" type="button">View blocked IPs</button>
        <button id="viewServerBackups" class="button button-outline" type="button">View backups</button>
      </div>
      <div class="row-actions settings-submit-actions">
        <button id="saveSettings" type="submit">Save settings</button>
        <span id="saved" class="success" role="status"></span>
      </div>
    </form>
    <dialog id="blockedIPsDialog" class="admin-dialog" aria-labelledby="blockedIPsTitle">
      <div class="admin-dialog-heading">
        <h2 id="blockedIPsTitle">Blocked login IPs</h2>
        <button id="closeBlockedIPs" class="button button-outline" type="button">Close</button>
      </div>
      <p class="muted">Blocked addresses do not expire. Disable automatic blocking to stop enforcing stored blocks.</p>
      <div id="blockedIPsError" class="notice" role="alert"></div>
      <p id="blockedIPsEmpty" class="muted" hidden>No IP addresses are blocked.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>IP address</th><th>Blocked at (UTC)</th><th>Failed logins</th><th>Action</th></tr></thead>
          <tbody id="blockedIPs"></tbody>
        </table>
      </div>
    </dialog>
    <dialog id="serverBackupsDialog" class="admin-dialog" aria-labelledby="serverBackupsTitle">
      <div class="admin-dialog-heading">
        <h2 id="serverBackupsTitle">Server backups</h2>
        <button id="closeServerBackups" class="button button-outline" type="button">Close</button>
      </div>
      <div id="serverBackupsError" class="notice" role="alert"></div>
      <p id="serverBackupsEmpty" class="muted" hidden>No server backups found.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Name</th><th>Created at (UTC)</th><th>Operators</th><th>Secrets</th><th>API tokens</th></tr></thead>
          <tbody id="serverBackups"></tbody>
        </table>
      </div>
    </dialog>
  </section>
</main>
<script>
const errorBox = document.getElementById('error');
const backupCron = document.getElementById('serverBackupCron');
const backupCronDescription = document.getElementById('serverBackupCronDescription');
const cronFields = [
  {unit:'second', min:0, max:59},
  {unit:'minute', min:0, max:59},
  {unit:'hour', min:0, max:23},
  {unit:'day of month', plural:'days of month', min:1, max:31},
  {unit:'month', min:1, max:12, names:['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'], labels:['January','February','March','April','May','June','July','August','September','October','November','December']},
  {unit:'day of week', plural:'days of week', min:0, max:6, names:['sun','mon','tue','wed','thu','fri','sat'], labels:['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']}
];
function describeCronField(field, spec) {
  let unrestricted = false;
  const parts = field.toLowerCase().split(',').map(part => {
    const match = /^(\*|\?|[a-z]+|\d+)(?:-([a-z]+|\d+))?(?:\/(\d+))?$/.exec(part);
    if (!match) return null;
    const value = token => {
      if (/^\d+$/.test(token)) return Number(token);
      const index = spec.names ? spec.names.indexOf(token) : -1;
      return index < 0 ? NaN : index + spec.min;
    };
    const wildcard = match[1] === '*' || match[1] === '?';
    if (wildcard && match[2]) return null;
    const start = wildcard ? spec.min : value(match[1]);
    const end = match[2] ? value(match[2]) : (wildcard || match[3] ? spec.max : start);
    const step = match[3] ? Number(match[3]) : 1;
    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || !Number.isSafeInteger(step) ||
        start < spec.min || end > spec.max || start > end || step < 1) return null;
    if (wildcard && step === 1) unrestricted = true;
    const label = number => spec.labels ? spec.labels[number - spec.min] : number;
    const plural = spec.plural || `${spec.unit}s`;
    if (wildcard && step === 1) return `every ${spec.unit}`;
    if (wildcard && step > 1) return `every ${step} ${plural}, starting at ${label(start)}`;
    if (match[3] && step > 1) return `every ${step} ${plural} from ${label(start)} through ${label(end)}`;
    if (start !== end) return `${plural} ${label(start)} through ${label(end)}`;
    return `${spec.unit} ${label(start)}`;
  });
  if (parts.some(part => part === null)) return null;
  return {text:parts.join(' or '), unrestricted};
}
function describeBackupCron(expression) {
  const fields = expression.trim().split(/\s+/);
  if (fields.length !== 6) return 'Enter a six-field cron expression to see its description.';
  const descriptions = fields.map((field, index) => describeCronField(field, cronFields[index]));
  if (descriptions.some(description => description === null)) {
    return 'Description unavailable for this expression. The server validates the schedule when saved.';
  }
  const [second, minute, hour, day, month, weekday] = descriptions;
  if (fields.slice(0, 3).every(field => /^\d+$/.test(field)) &&
      fields.slice(3).every(field => field === '*' || field === '?')) {
    const time = [fields[2], fields[1], fields[0]].map(value => String(Number(value)).padStart(2, '0')).join(':');
    return `Every day at ${time} UTC.`;
  }
  const dayJoin = day.unrestricted || weekday.unrestricted ? ' and ' : ' or ';
  return `Runs at ${second.text}, ${minute.text}, ${hour.text}; in ${month.text}; on ${day.text}${dayJoin}${weekday.text} (UTC).`;
}
function updateBackupCronDescription() {
  backupCronDescription.textContent = describeBackupCron(backupCron.value);
}
backupCron.addEventListener('input', updateBackupCronDescription);
async function api(url, options = {}) {
  options.credentials = 'same-origin';
  const response = await fetch(url, options);
  const body = await response.json().catch(() => ({}));
  if (!response.ok) {
    if (response.status === 401) location.assign('/401.html');
    throw new Error(body.error || 'Request failed');
  }
  return body;
}
async function loadSettings() {
  try {
    const settings = await api('/v1/settings');
    document.getElementById('enforceMTLS').checked = settings.enforce_mtls;
    document.getElementById('autoBlockLoginBruteforceIP').checked = settings.auto_block_login_bruteforce_ip;
    document.getElementById('enforceMFA').checked = settings.enforce_mfa;
    document.getElementById('fileLogging').checked = settings.file_logging;
    document.getElementById('automaticServerBackup').checked = settings.automatic_server_backup;
    backupCron.value = settings.server_backup_cron;
    updateBackupCronDescription();
    document.getElementById('lastServerBackup').textContent = settings.server_backup_last_success || 'None';
  } catch (error) {
    errorBox.textContent = error.message;
  }
}
document.getElementById('settingsForm').addEventListener('submit', async event => {
  event.preventDefault();
  const button = document.getElementById('saveSettings');
  const saved = document.getElementById('saved');
  button.disabled = true;
  saved.textContent = '';
  errorBox.textContent = '';
  try {
    const updated = await api('/v1/settings', {
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        enforce_mtls:document.getElementById('enforceMTLS').checked,
        auto_block_login_bruteforce_ip:document.getElementById('autoBlockLoginBruteforceIP').checked,
        enforce_mfa:document.getElementById('enforceMFA').checked,
        file_logging:document.getElementById('fileLogging').checked,
        automatic_server_backup:document.getElementById('automaticServerBackup').checked,
        server_backup_cron:document.getElementById('serverBackupCron').value.trim()
      })
    });
    document.getElementById('lastServerBackup').textContent = updated.server_backup_last_success || 'None';
    saved.textContent = 'Settings saved.';
  } catch (error) {
    errorBox.textContent = error.message;
  } finally {
    button.disabled = false;
  }
});

async function refreshBlockedIPs() {
  const body = document.getElementById('blockedIPs');
  const empty = document.getElementById('blockedIPsEmpty');
  body.replaceChildren();
  const result = await api('/v1/settings/blocked-login-ips');
  for (const blocked of result.blocked_ips) {
    const row = body.insertRow();
    for (const value of [blocked.ip, blocked.blocked_at, blocked.failure_count]) {
      const cell = row.insertCell();
      cell.textContent = String(value);
    }
    const action = row.insertCell();
    const unblock = document.createElement('button');
    unblock.type = 'button';
    unblock.className = 'button button-outline';
    unblock.textContent = 'Unblock';
    unblock.addEventListener('click', async () => {
      if (!window.confirm(`Unblock ${blocked.ip}?`)) return;
      unblock.disabled = true;
      const dialogError = document.getElementById('blockedIPsError');
      dialogError.textContent = '';
      try {
        await api(`/v1/settings/blocked-login-ips/${encodeURIComponent(blocked.ip)}`, {method:'DELETE'});
        await refreshBlockedIPs();
      } catch (error) {
        dialogError.textContent = error.message;
        unblock.disabled = false;
      }
    });
    action.append(unblock);
  }
  empty.hidden = result.blocked_ips.length !== 0;
}

document.getElementById('viewBlockedIPs').addEventListener('click', async () => {
  document.getElementById('blockedIPsError').textContent = '';
  try {
    await refreshBlockedIPs();
    const dialog = document.getElementById('blockedIPsDialog');
    dialog.showModal();
  } catch (error) {
    errorBox.textContent = error.message;
  }
});
document.getElementById('closeBlockedIPs').addEventListener('click', () => {
  document.getElementById('blockedIPsDialog').close();
});
async function refreshServerBackups() {
  const body = document.getElementById('serverBackups');
  const empty = document.getElementById('serverBackupsEmpty');
  body.replaceChildren();
  const result = await api('/v1/settings/server-backups');
  for (const backup of result.backups) {
    const row = body.insertRow();
    for (const value of [
      backup.name,
      new Date(backup.created_at).toLocaleString(undefined, {timeZone:'UTC'}),
      backup.operators,
      backup.secrets,
      backup.api_tokens
    ]) {
      const cell = row.insertCell();
      cell.textContent = value === null ? 'N/A' : String(value);
    }
  }
  empty.hidden = result.backups.length !== 0;
}
document.getElementById('viewServerBackups').addEventListener('click', async () => {
  const dialog = document.getElementById('serverBackupsDialog');
  const dialogError = document.getElementById('serverBackupsError');
  dialogError.textContent = '';
  dialog.showModal();
  try {
    await refreshServerBackups();
  } catch (error) {
    dialogError.textContent = error.message;
  }
});
document.getElementById('closeServerBackups').addEventListener('click', () => {
  document.getElementById('serverBackupsDialog').close();
});
loadSettings();
</script>
</body>
</html>
